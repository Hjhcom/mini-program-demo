<!-- pages/mine/mine.wxml —— 我的页面 -->
<view class="page {{dark ? 'dark' : ''}} {{fontScale == 'lg' ? 'font-lg' : fontScale == 'xl' ? 'font-xl' : ''}}">

  <!-- 未登录：登录引导卡片（按钮在下方区域） -->
  <view class="user-card" wx:if="{{!user}}">
    <view class="avatar avatar-guest">客</view>
    <view class="user-info">
      <text class="nickname">{{lang.mine.notLogin}}</text>
      <text class="status">{{lang.mine.loginHint}}</text>
    </view>
  </view>

  <!-- 已登录：用户卡片 -->
  <view class="user-card" wx:else>
    <view class="avatar" wx:if="{{user.avatarUrl}}">
      <image class="avatar-img" src="{{avatarDisplay}}" mode="aspectFill" />
    </view>
    <view class="avatar" wx:else>{{ user.nickname ? user.nickname[0] : '客' }}</view>
    <view class="user-info">
      <text class="nickname">{{ user.nickname }}</text>
      <text class="status">{{ user.source == 'guest' ? lang.mine.guestHint : lang.mine.loggedIn }}</text>
    </view>
    <!-- 资料不全：提供完善入口 -->
    <button class="profile-btn" wx:if="{{needProfile}}" bindtap="goProfile">{{lang.mine.profileBtn}}</button>
  </view>

  <!-- 我的邀请码（仅云端用户；游客本地身份无邀请码） -->
  <view class="invite-card" wx:if="{{user && user.source != 'guest'}}">
    <text class="invite-label">{{lang.mine.myInvite}}</text>
    <text class="invite-code">{{user.inviteCode || '——'}}</text>
    <button class="invite-btn copy" bindtap="copyInvite">{{lang.mine.copy}}</button>
    <button class="invite-btn share" open-type="share">{{lang.mine.inviteFriend}}</button>
  </view>

  <!-- 功能列表 -->
  <view class="cell-group">
    <view class="cell" bindtap="onItemTap" data-type="records">
      <text class="cell-label">{{lang.mine.records}}</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onItemTap" data-type="task">
      <text class="cell-label">{{lang.mine.task}}</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onItemTap" data-type="pk">
      <text class="cell-label">{{lang.mine.pk}}</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onItemTap" data-type="ranking">
      <text class="cell-label">{{lang.mine.ranking}}</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onItemTap" data-type="badges">
      <text class="cell-label">{{lang.mine.badges}}</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onItemTap" data-type="settings">
      <text class="cell-label">{{lang.mine.settings}}</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onItemTap" data-type="about">
      <text class="cell-label">{{lang.mine.about}}</text>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <!-- 未登录：登录按钮（页面下方） -->
  <view class="login-section" wx:if="{{!user}}">
    <button class="login-btn" bindtap="goLogin">{{lang.mine.loginBtn}}</button>
  </view>

  <!-- 退出登录（仅登录后显示） -->
  <view class="logout-wrap" wx:if="{{user}}">
    <button class="logout" bindtap="onLogout">{{lang.mine.logout}}</button>
  </view>

</view>
