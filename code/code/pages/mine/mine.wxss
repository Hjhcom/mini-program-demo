/* 我的页面样式（风格与首页一致：主色 #4A90D9） */
.page {
  min-height: 100vh;
  position: relative;
  background: #f5f6f7;
}

/* 校园插画背景（仅浅色模式） */
.page-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  width: 100%;
  height: 100vh;
  z-index: 0;
}
.page-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg,
    rgba(255,255,255,0.35) 0%,
    rgba(255,255,255,0.65) 35%,
    rgba(245,246,247,0.92) 100%);
  z-index: 1;
}
.content {
  position: relative;
  z-index: 2;
}
.page.dark .page-bg,
.page.dark .page-mask { display: none; }
.page.dark .content { z-index: auto; }

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  padding: 90rpx 40rpx 70rpx;
  background: linear-gradient(135deg, rgba(107,182,255,0.92) 0%, rgba(74,144,217,0.92) 100%);
  border-radius: 0 0 40rpx 40rpx;
  position: relative;
  overflow: hidden;
}

/* 1940 水印（建校年份） */
.card-watermark {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 120rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.12);
  letter-spacing: 8rpx;
  pointer-events: none;
}

/* 未登录头像 */
.avatar-guest {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

/* 未登录：登录按钮区域（页面下方） */
.login-section {
  margin: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 登录按钮（全宽主色） */
.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
  background: linear-gradient(135deg, #6BB6FF 0%, #4A90D9 100%);
  border-radius: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(74, 144, 217, 0.35);
}

.login-btn::after {
  border: none;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  text-align: center;
  border-radius: 50%;
  background: #ffffff;
  color: #4A90D9;
  font-size: 52rpx;
  font-weight: bold;
  margin-right: 30rpx;
  overflow: hidden;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

/* 已登录资料不全：「完善头像昵称」按钮 */
.profile-btn {
  margin-left: auto;
  padding: 0 30rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  color: #4A90D9;
  background: #ffffff;
  border-radius: 30rpx;
}

.profile-btn::after {
  border: none;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.nickname {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: bold;
}

.status {
  color: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 功能列表 */
.cell-group {
  margin: 24rpx;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(74,144,217,0.08);
}

/* 我的邀请码卡片 */
.invite-card {
  margin: 24rpx;
  padding: 28rpx 30rpx;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(74,144,217,0.08);
}

.invite-label {
  font-size: 26rpx;
  color: #999999;
  white-space: nowrap;
}

.invite-code {
  flex: 1;
  margin: 0 16rpx;
  font-size: 32rpx;
  color: #4A90D9;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.invite-btn {
  margin-left: 12rpx;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  border-radius: 28rpx;
}

.invite-btn::after {
  border: none;
}

.invite-btn.copy {
  background: #ffffff;
  color: #4A90D9;
  border: 2rpx solid #4A90D9;
}

.invite-btn.share {
  background: #4A90D9;
  color: #ffffff;
}

/* 深色模式 */
.page.dark .invite-card {
  background: #2c2c2e;
}

.page.dark .invite-code {
  color: #8ab4e8;
}

.page.dark .invite-btn.copy {
  background: #2c2c2e;
  color: #8ab4e8;
  border-color: #8ab4e8;
}

.page.dark .invite-btn.share {
  background: #4A90D9;
  color: #ffffff;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx;
  border-bottom: 2rpx solid #f5f6f7;
  transition: background 0.2s;
}

.cell:active {
  background: #f7f9fc;
}

.cell:last-child {
  border-bottom: none;
}

.cell-label {
  font-size: 30rpx;
  color: #333333;
}

.cell-arrow {
  font-size: 36rpx;
  color: #cccccc;
}

/* 退出登录 */
.logout-wrap {
  margin: 40rpx;
}

.logout {
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(10rpx);
  color: #d33a31;
  font-size: 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(74,144,217,0.08);
}

.logout::after {
  border: none;
}
