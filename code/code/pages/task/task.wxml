<!-- pages/task/task.wxml —— 打卡任务：我发布的 / 我接的 -->
<view class="page {{dark ? 'dark' : ''}} {{fontScale == 'lg' ? 'font-lg' : fontScale == 'xl' ? 'font-xl' : ''}}">

  <!-- 顶部：Tab 切换 + 输入任务码入口 -->
  <view class="head">
    <view class="tabs">
      <view class="tab {{tab == 'created' ? 'on' : ''}}" bindtap="onTabTap" data-tab="created">{{lang.task.tabCreated}}</view>
      <view class="tab {{tab == 'assigned' ? 'on' : ''}}" bindtap="onTabTap" data-tab="assigned">{{lang.task.tabAssigned}}</view>
    </view>
    <view class="code-entry" bindtap="onAcceptTap">{{lang.task.enterCode}}</view>
  </view>

  <!-- 未登录 -->
  <view class="empty" wx:if="{{!loggedIn && !loading}}">
    <text class="empty-text">{{lang.task.loginFirst}}</text>
    <button class="empty-btn" bindtap="goLogin">{{lang.task.goLogin}}</button>
  </view>

  <!-- 任务列表 -->
  <view class="list" wx:elif="{{tasks.length > 0}}">
    <view class="task-item" wx:for="{{tasks}}" wx:key="_id" bindtap="onTaskTap" data-index="{{index}}">
      <view class="task-top">
        <text class="task-title">{{item.title}}</text>
        <view class="task-badge {{item.statusCls}}">{{item.statusText}}</view>
      </view>
      <view class="task-meta">📍 {{item.pointName}}</view>
      <view class="task-meta">🗣 {{lang.task.spellPrefix}}{{item.spell}}</view>
      <view class="task-foot">
        <text class="task-time">{{lang.task.deadlinePrefix}}{{item.deadlineText}}</text>
        <text class="task-code" wx:if="{{item.canCopyCode}}">{{item.codeText}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:elif="{{!loading}}">
    <text class="empty-text">{{tab == 'created' ? lang.task.emptyCreated : lang.task.emptyAssigned}}</text>
    <button class="empty-btn" wx:if="{{tab == 'created'}}" bindtap="goCreate">{{lang.task.createTask}}</button>
    <button class="empty-btn" wx:else bindtap="onAcceptTap">{{lang.task.enterCode}}</button>
  </view>

  <!-- 右下角悬浮按钮：发布任务 -->
  <view class="fab" bindtap="goCreate">＋</view>

</view>
