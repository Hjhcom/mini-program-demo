/* 成就徽章页样式（主色 #1f4e79，卡片圆角 16rpx，与 ranking / records 保持一致）
   注意：.empty-text / .pop-title 的样式（含深色）已在 app.wxss 全局定义，这里不重复定义。 */
.page {
  min-height: 100vh;
  background: #f5f6f7;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* ===== 通用按钮 ===== */
.btn-primary {
  width: 320rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  color: #ffffff;
  background: #1f4e79;
  border-radius: 42rpx;
}

.btn-primary::after {
  border: none;
}

.btn-home {
  margin: 16rpx auto 0;
}

/* ===== 未登录 ===== */
.login-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.login-text {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
  padding: 0 60rpx;
  margin-bottom: 44rpx;
}

/* ===== 连续打卡卡 ===== */
.streak-card {
  margin: 24rpx 30rpx 0;
  padding: 28rpx 34rpx 30rpx;
  background: #1f4e79;
  border-radius: 16rpx;
}

.streak-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.streak-label {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: bold;
}

.streak-today {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.streak-today.on {
  color: #ffd766;
}

.streak-body {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.streak-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.streak-num-line {
  display: flex;
  align-items: baseline;
}

.streak-num {
  font-size: 60rpx;
  line-height: 1.1;
  color: #ffd766;
  font-weight: bold;
}

.streak-suffix {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 8rpx;
}

.streak-sub {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
}

.streak-divider {
  width: 2rpx;
  height: 70rpx;
  background: rgba(255, 255, 255, 0.25);
}

/* ===== 提示条（user_badges 集合未建）===== */
.warn-bar {
  margin: 20rpx 30rpx 0;
  padding: 18rpx 24rpx;
  background: #fff7e6;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8a6100;
}

/* ===== 空状态 ===== */
.empty-box {
  padding: 36rpx 60rpx 0;
  text-align: center;
}

/* ===== 徽章墙 ===== */
.section-title {
  margin: 36rpx 30rpx 20rpx;
  font-size: 26rpx;
  color: #666666;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 30rpx;
}

.badge {
  width: 48%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 34rpx 20rpx 30rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
}

.badge.got {
  background: #fffdf5;
  border-color: #ffd766;
}

.badge-icon {
  font-size: 68rpx;
  line-height: 1;
}

.badge.locked .badge-icon {
  opacity: 0.3;
}

.badge-name {
  font-size: 27rpx;
  color: #333333;
  font-weight: bold;
  margin-top: 18rpx;
}

.badge.locked .badge-name {
  color: #999999;
  font-weight: normal;
}

.badge-foot {
  font-size: 22rpx;
  color: #999999;
  margin-top: 10rpx;
  text-align: center;
}

.badge.got .badge-foot {
  color: #b8860b;
}

/* ===== 加载中 ===== */
.loading-box {
  padding: 60rpx 0;
  text-align: center;
}

.loading-text {
  font-size: 26rpx;
  color: #999999;
}

/* ===== 徽章详情弹窗 ===== */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pop {
  width: 600rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 44rpx 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.pop-icon {
  font-size: 100rpx;
  line-height: 1;
}

.pop-icon.locked {
  opacity: 0.3;
}

.pop-title {
  margin-top: 24rpx;
}

.pop-status {
  font-size: 24rpx;
  color: #999999;
  margin-top: 12rpx;
}

.pop-status.got {
  color: #b8860b;
}

.pop-cond {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  text-align: center;
  margin-top: 26rpx;
}

.pop-progress {
  font-size: 25rpx;
  color: #1f4e79;
  margin-top: 14rpx;
}

.pop-btn {
  margin-top: 42rpx;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  color: #ffffff;
  background: #1f4e79;
  border-radius: 42rpx;
}

.pop-btn::after {
  border: none;
}

/* ===== 深色模式（只补本页新增元素）===== */
.page.dark .streak-card {
  background: #2c3a49;
}

.page.dark .badge {
  background: #2c2c2e;
}

.page.dark .badge.got {
  background: #2f2a1c;
  border-color: #8a6100;
}

.page.dark .badge-name {
  color: #e5e5e5;
}

.page.dark .badge.locked .badge-name {
  color: #9a9a9c;
}

.page.dark .badge-foot,
.page.dark .section-title,
.page.dark .loading-text,
.page.dark .login-text {
  color: #9a9a9c;
}

.page.dark .badge.got .badge-foot,
.page.dark .pop-status.got {
  color: #e8c46a;
}

.page.dark .warn-bar {
  background: #3a3222;
  color: #e8c46a;
}

.page.dark .pop {
  background: #2c2c2e;
}

.page.dark .pop-cond {
  color: #9a9a9c;
}

.page.dark .pop-progress {
  color: #8ab4e8;
}

/* ===== 字体大小（跟随全局设置）===== */
.page.font-lg .streak-label { font-size: 31rpx; }
.page.font-lg .streak-num { font-size: 66rpx; }
.page.font-lg .streak-sub,
.page.font-lg .badge-foot,
.page.font-lg .section-title,
.page.font-lg .loading-text,
.page.font-lg .pop-cond { font-size: 26rpx; }
.page.font-lg .badge-name { font-size: 30rpx; }
.page.font-lg .login-text { font-size: 31rpx; }
.page.font-lg .pop-title { font-size: 37rpx; }

.page.font-xl .streak-label { font-size: 34rpx; }
.page.font-xl .streak-num { font-size: 72rpx; }
.page.font-xl .streak-sub,
.page.font-xl .badge-foot,
.page.font-xl .section-title,
.page.font-xl .loading-text,
.page.font-xl .pop-cond { font-size: 29rpx; }
.page.font-xl .badge-name { font-size: 33rpx; }
.page.font-xl .login-text { font-size: 34rpx; }
.page.font-xl .pop-title { font-size: 40rpx; }
