<!-- pages/records/records.wxml —— 我的打卡记录 -->
<view class="page {{dark ? 'dark' : ''}} {{fontScale == 'lg' ? 'font-lg' : fontScale == 'xl' ? 'font-xl' : ''}}">

  <!-- 统计栏 -->
  <view class="stat-bar">
    <view class="stat">
      <text class="stat-num">{{total}}</text>
      <text class="stat-label">{{lang.records.total}}</text>
    </view>
    <view class="stat">
      <text class="stat-num ok">{{successCount}}</text>
      <text class="stat-label">{{lang.records.success}}</text>
    </view>
  </view>

  <!-- 记录列表 -->
  <view class="list" wx:if="{{records.length > 0}}">
    <view class="record-item" wx:for="{{records}}" wx:key="_id" bindtap="onItemTap" data-index="{{index}}">
      <view class="status-dot {{item.matched ? 'ok' : 'fail'}}"></view>
      <view class="record-main">
        <text class="record-name">{{item.pointName}}</text>
        <text class="record-time">{{item.timeText}}</text>
      </view>
      <view class="record-badge {{item.matched ? 'ok' : 'fail'}}">{{item.matched ? lang.records.okBadge : lang.records.failBadge}}</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:elif="{{!loading}}">
    <text class="empty-text">{{lang.records.empty}}</text>
    <button class="empty-btn" bindtap="goHome">{{lang.records.goHome}}</button>
  </view>

  <!-- 详情弹窗 -->
  <view class="mask" wx:if="{{showDetail}}">
    <view class="detail-pop">
      <view class="detail-name">{{detail.pointName}}</view>
      <view class="detail-status {{detail.matched ? 'ok' : 'fail'}}">{{detail.matched ? lang.records.okBadge : lang.records.failDetail}}</view>

      <view class="detail-row">
        <text class="detail-label">{{lang.records.time}}</text>
        <text class="detail-value">{{detail.timeText}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">{{lang.records.spell}}</text>
        <text class="detail-value">{{detail.spell}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">{{lang.records.recognized}}</text>
        <text class="detail-value">{{detail.recognizedText || lang.records.none}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">{{lang.records.similarity}}</text>
        <text class="detail-value">{{detail.simText}}</text>
      </view>

      <button class="detail-close" bindtap="closeDetail">{{lang.records.close}}</button>
    </view>
  </view>

</view>
