<!-- pages/records/records.wxml —— 我的打卡记录 -->
<view class="page">

  <!-- 统计栏 -->
  <view class="stat-bar">
    <view class="stat">
      <text class="stat-num">{{total}}</text>
      <text class="stat-label">总记录</text>
    </view>
    <view class="stat">
      <text class="stat-num ok">{{successCount}}</text>
      <text class="stat-label">打卡成功</text>
    </view>
  </view>

  <!-- 记录列表 -->
  <view class="list" wx:if="{{records.length > 0}}">
    <view class="record-item" wx:for="{{records}}" wx:key="_id" bindtap="onItemTap" data-index="{{index}}">
      <view class="status-dot {{item.matched ? 'ok' : 'fail'}}"></view>
      <view class="record-main">
        <text class="record-name">{{item.pointName}}</text>
        <text class="record-time">{{item.timeText}}</text>
      </view>
      <view class="record-badge {{item.matched ? 'ok' : 'fail'}}">{{item.matched ? '打卡成功' : '未匹配'}}</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:elif="{{!loading}}">
    <text class="empty-text">暂无打卡记录</text>
    <button class="empty-btn" bindtap="goHome">去首页打卡</button>
  </view>

  <!-- 详情弹窗 -->
  <view class="mask" wx:if="{{showDetail}}">
    <view class="detail-pop">
      <view class="detail-name">{{detail.pointName}}</view>
      <view class="detail-status {{detail.matched ? 'ok' : 'fail'}}">{{detail.matched ? '打卡成功' : '打卡失败'}}</view>

      <view class="detail-row">
        <text class="detail-label">打卡时间</text>
        <text class="detail-value">{{detail.timeText}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">应念咒语</text>
        <text class="detail-value">{{detail.spell}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">识别结果</text>
        <text class="detail-value">{{detail.recognizedText || '无'}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">相似度</text>
        <text class="detail-value">{{detail.simText}}</text>
      </view>

      <button class="detail-close" bindtap="closeDetail">关闭</button>
    </view>
  </view>

</view>
