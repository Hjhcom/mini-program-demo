/* pages/dashboard/dashboard.wxss —— 数据大屏（深蓝科技 + 北理工元素） */
page {
  background: #050e1e;
}
.dash {
  position: relative;
  min-height: 100vh;
  padding: 28rpx 24rpx 60rpx;
  box-sizing: border-box;
  background: radial-gradient(ellipse 120% 80% at 50% -10%, #0d2a4a 0%, #071a33 55%, #050e1e 100%);
  overflow: hidden;
}
.watermark {
  position: fixed;
  right: -30rpx;
  bottom: -40rpx;
  font-size: 400rpx;
  font-weight: 900;
  color: rgba(74, 144, 217, 0.06);
  z-index: 0;
  pointer-events: none;
  line-height: 1;
}

/* 顶部 */
.head {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx 0;
}
.logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(245, 194, 107, 0.8);
  box-shadow: 0 0 24rpx rgba(245, 194, 107, 0.4);
  background: #fff;
  flex-shrink: 0;
}
.head-txt {
  flex: 1;
  margin-left: 20rpx;
}
.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}
.sub {
  display: block;
  font-size: 22rpx;
  color: #8FA8C4;
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}
.badge {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(127, 192, 255, 0.5);
  color: #7FC0FF;
  background: rgba(74, 144, 217, 0.15);
  flex-shrink: 0;
}
.badge.demo {
  border-color: rgba(245, 194, 107, 0.6);
  color: #F5C26B;
  background: rgba(245, 194, 107, 0.12);
}
.update {
  font-size: 20rpx;
  color: #8FA8C4;
  padding: 10rpx 8rpx 4rpx;
}

/* 指标卡 */
.metrics {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.metric {
  width: calc(50% - 10rpx);
  margin: 10rpx 0;
  box-sizing: border-box;
  background: linear-gradient(135deg, rgba(74, 144, 217, 0.12), rgba(74, 144, 217, 0.03));
  border: 1rpx solid rgba(74, 144, 217, 0.3);
  border-radius: 20rpx;
  padding: 24rpx;
  position: relative;
  overflow: hidden;
}
.metric:nth-child(odd) { margin-right: 20rpx; }
.metric::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #7FC0FF, transparent);
}
.metric.gold { border-color: rgba(245, 194, 107, 0.45); }
.metric.gold::before { background: linear-gradient(90deg, transparent, #F5C26B, transparent); }
.m-label {
  font-size: 24rpx;
  color: #8FA8C4;
}
.m-value {
  display: block;
  font-size: 72rpx;
  font-weight: 800;
  color: #EAF2FA;
  margin-top: 8rpx;
  text-shadow: 0 0 30rpx rgba(127, 192, 255, 0.5);
}
.metric.gold .m-value { text-shadow: 0 0 30rpx rgba(245, 194, 107, 0.5); }
.m-unit { font-size: 32rpx; color: #8FA8C4; font-weight: 400; margin-left: 4rpx; }

/* 面板 */
.panel {
  margin-top: 24rpx;
  background: rgba(10, 28, 52, 0.6);
  border: 1rpx solid rgba(74, 144, 217, 0.25);
  border-radius: 20rpx;
  padding: 24rpx;
}
.p-title {
  font-size: 28rpx;
  color: #EAF2FA;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}
.p-title::before {
  content: "";
  width: 8rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #7FC0FF, #4A90D9);
  margin-right: 12rpx;
}

/* 最近打卡 */
.feed-item {
  background: rgba(74, 144, 217, 0.08);
  border: 1rpx solid rgba(74, 144, 217, 0.2);
  border-left: 6rpx solid #4A90D9;
  border-radius: 14rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
}
.f-who { font-size: 24rpx; color: #7FC0FF; font-weight: 600; }
.f-what { font-size: 26rpx; color: #EAF2FA; margin-top: 6rpx; }
.f-when { font-size: 20rpx; color: #8FA8C4; margin-top: 6rpx; }

/* 排行榜 */
.rank-row {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(74, 144, 217, 0.06);
  border: 1rpx solid rgba(74, 144, 217, 0.15);
  margin-bottom: 12rpx;
}
.rank-row.top3 {
  border-color: rgba(245, 194, 107, 0.5);
  background: rgba(245, 194, 107, 0.07);
}
.r-no {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.08);
  color: #8FA8C4;
  flex-shrink: 0;
}
.rank-row.top3 .r-no {
  background: linear-gradient(135deg, #F5C26B, #E0A84A);
  color: #3A2400;
  font-size: 30rpx;
}
.r-name {
  flex: 1;
  margin-left: 20rpx;
  font-size: 26rpx;
  color: #EAF2FA;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.r-count { font-size: 34rpx; font-weight: 700; color: #7FC0FF; }
.r-unit { font-size: 20rpx; color: #8FA8C4; font-weight: 400; margin-left: 4rpx; }

/* 点位热度 */
.heat-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.h-name {
  width: 200rpx;
  font-size: 24rpx;
  color: #EAF2FA;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  flex-shrink: 0;
}
.h-bar {
  flex: 1;
  height: 22rpx;
  border-radius: 11rpx;
  background: rgba(74, 144, 217, 0.15);
  overflow: hidden;
  margin: 0 16rpx;
}
.h-fill {
  height: 100%;
  border-radius: 11rpx;
  background: linear-gradient(90deg, rgba(74, 144, 217, 0.35), #4A90D9);
  transition: width 0.6s ease;
}
.h-count { font-size: 24rpx; color: #7FC0FF; font-weight: 600; }

/* 剧本完成率 */
.route-wrap { display: flex; flex-direction: column; align-items: center; padding: 8rpx 0; }
.route-ring {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.route-inner {
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  background: #071a33;
  display: flex;
  align-items: center;
  justify-content: center;
}
.route-num { font-size: 56rpx; font-weight: 800; color: #F5C26B; }
.route-tip { font-size: 22rpx; color: #8FA8C4; margin-top: 16rpx; }

.empty {
  font-size: 24rpx;
  color: #8FA8C4;
  text-align: center;
  padding: 30rpx 0;
}
