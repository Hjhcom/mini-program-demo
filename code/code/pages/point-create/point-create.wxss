/* pages/point-create/point-create.wxss —— 自建打卡点页样式 */
.page {
  min-height: 100vh;
  background: #f5f6f7;
  padding: 24rpx 30rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 表单卡片 ===== */
.form-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.form-label:not(:first-child) {
  margin-top: 30rpx;
}

.required {
  color: #d33a31;
  margin-left: 6rpx;
}

.form-input {
  height: 80rpx;
  line-height: 80rpx;
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333333;
  box-sizing: border-box;
}

/* 字数提示（右对齐的小字） */
.counter {
  text-align: right;
  font-size: 22rpx;
  color: #bbbbbb;
  margin-top: 8rpx;
}

.counter.over {
  color: #d33a31;
  font-weight: bold;
}

.hint {
  font-size: 22rpx;
  color: #999999;
  margin-top: 12rpx;
  line-height: 1.6;
}

/* ===== 位置 ===== */
.loc-picked {
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
}

.loc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.loc-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-src {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 20rpx;
  color: #4A90D9;
  background: #eef3f8;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
}

.loc-addr {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
  line-height: 1.5;
}

.loc-coord {
  display: block;
  font-size: 22rpx;
  color: #bbbbbb;
  margin-top: 8rpx;
  font-family: Menlo, Consolas, monospace;
}

.loc-empty {
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 30rpx 24rpx;
  font-size: 26rpx;
  color: #999999;
  text-align: center;
}

.loc-btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.loc-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: #4A90D9;
  border-radius: 38rpx;
}

.loc-btn::after {
  border: none;
}

.loc-btn-ghost {
  color: #4A90D9;
  background: #eef3f8;
}

/* ===== 半径选项 ===== */
.radius-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.radius-option {
  padding: 14rpx 34rpx;
  font-size: 28rpx;
  color: #333333;
  background: #f5f6f7;
  border-radius: 28rpx;
}

.radius-option.on {
  background: #4A90D9;
  color: #ffffff;
}

/* ===== 提交按钮 ===== */
.submit-btn {
  margin-top: 50rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: #ffffff;
  background: #4A90D9;
  border-radius: 44rpx;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #9bb4c9;
  color: #ffffff;
}

/* ===== 成功弹窗 ===== */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.succ-pop {
  width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.pop-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.pop-name {
  font-size: 32rpx;
  color: #4A90D9;
  font-weight: bold;
  margin-top: 20rpx;
  text-align: center;
  line-height: 1.4;
}

.pop-sub {
  font-size: 24rpx;
  color: #999999;
  margin-top: 12rpx;
  text-align: center;
  line-height: 1.5;
}

.pop-remain {
  font-size: 22rpx;
  color: #bbbbbb;
  margin-top: 16rpx;
}

.succ-main {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  color: #ffffff;
  background: #4A90D9;
  border-radius: 42rpx;
  margin-top: 40rpx;
}

.succ-main::after {
  border: none;
}

.succ-ghost {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  color: #4A90D9;
  background: #eef3f8;
  border-radius: 42rpx;
  margin-top: 20rpx;
}

.succ-ghost::after {
  border: none;
}

/* ===== 深色模式 ===== */
.page.dark .form-card {
  background: #2c2c2e;
}

.page.dark .form-label {
  color: #e5e5e5;
}

.page.dark .form-input {
  background: #3a3a3c;
  color: #e5e5e5;
}

.page.dark .loc-picked,
.page.dark .loc-empty {
  background: #3a3a3c;
}

.page.dark .loc-name {
  color: #e5e5e5;
}

.page.dark .loc-src {
  color: #7fb0dd;
  background: #26384a;
}

.page.dark .loc-addr,
.page.dark .loc-empty {
  color: #9a9a9c;
}

.page.dark .loc-coord,
.page.dark .counter {
  color: #77777a;
}

.page.dark .hint {
  color: #9a9a9c;
}

.page.dark .loc-btn-ghost {
  color: #7fb0dd;
  background: #26384a;
}

.page.dark .radius-option {
  background: #3a3a3c;
  color: #e5e5e5;
}

.page.dark .radius-option.on {
  background: #4A90D9;
  color: #ffffff;
}

.page.dark .succ-pop {
  background: #2c2c2e;
}

.page.dark .pop-title {
  color: #e5e5e5;
}

.page.dark .pop-name {
  color: #7fb0dd;
}

.page.dark .pop-sub,
.page.dark .pop-remain {
  color: #9a9a9c;
}

.page.dark .succ-ghost {
  color: #7fb0dd;
  background: #26384a;
}

/* ===== 字体大小 ===== */
.page.font-lg .form-label { font-size: 31rpx; }
.page.font-lg .form-input { font-size: 33rpx; }
.page.font-lg .loc-name { font-size: 33rpx; }
.page.font-lg .hint { font-size: 24rpx; }

.page.font-xl .form-label { font-size: 34rpx; }
.page.font-xl .form-input { font-size: 36rpx; }
.page.font-xl .loc-name { font-size: 36rpx; }
.page.font-xl .hint { font-size: 26rpx; }
