<!-- pages/task-create/task-create.wxml —— 发布打卡任务 -->
<view class="page {{dark ? 'dark' : ''}} {{fontScale == 'lg' ? 'font-lg' : fontScale == 'xl' ? 'font-xl' : ''}}">

  <!-- 1. 任务内容 -->
  <view class="form-card">
    <view class="form-label">{{lang.taskCreate.labelTitle}}<text class="required">*</text></view>
    <input class="form-input" placeholder="{{lang.taskCreate.titlePlaceholder}}" maxlength="30"
           value="{{title}}" bindinput="onTitleInput" />
    <view class="form-label">{{lang.taskCreate.labelDesc}}</view>
    <input class="form-input" placeholder="{{lang.taskCreate.descPlaceholder}}" maxlength="100"
           value="{{desc}}" bindinput="onDescInput" />
  </view>

  <!-- 2. 选择打卡点 -->
  <view class="form-card">
    <view class="form-label">{{lang.taskCreate.labelPoint}}<text class="required">*</text></view>
    <view class="point-item {{pointIndex == index ? 'on' : ''}}" wx:for="{{points}}" wx:key="_id"
          bindtap="onPointTap" data-index="{{index}}">
      <view class="point-main">
        <text class="point-name">{{item.name}}</text>
        <text class="point-spell">{{lang.taskCreate.spellPrefix}}{{item.spell}}</text>
      </view>
      <view class="point-check" wx:if="{{pointIndex == index}}">✓</view>
    </view>
    <view class="loading-tip" wx:if="{{points.length == 0}}">{{lang.taskCreate.pointsLoading}}</view>
  </view>

  <!-- 3. 有效期 -->
  <view class="form-card">
    <view class="form-label">{{lang.taskCreate.labelDuration}}</view>
    <view class="duration-row">
      <view class="duration-option {{durationIndex == index ? 'on' : ''}}" wx:for="{{durations}}"
            wx:key="*this" bindtap="onDurationTap" data-index="{{index}}">{{item}}</view>
    </view>
  </view>

  <button class="submit-btn" bindtap="onSubmit" disabled="{{submitting}}">{{lang.taskCreate.submit}}</button>

  <!-- 发布成功：大字显示任务码 -->
  <view class="mask" wx:if="{{showCode}}">
    <view class="code-pop">
      <view class="pop-title">{{lang.taskCreate.success}}</view>
      <view class="pop-sub">{{lang.taskCreate.successSub}}</view>
      <view class="code-big">{{inviteCode}}</view>
      <button class="code-copy" bindtap="copyCode">{{lang.taskCreate.copyCode}}</button>
      <view class="code-close" bindtap="closeCode">{{lang.taskCreate.backToList}}</view>
    </view>
  </view>

</view>
