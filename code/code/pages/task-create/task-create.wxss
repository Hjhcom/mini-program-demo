/* pages/task-create/task-create.wxss —— 发布任务页样式 */
.page {
  min-height: 100vh;
  background: #f5f6f7;
  padding: 24rpx 30rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 表单卡片 ===== */
.form-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.form-label:not(:first-child) {
  margin-top: 30rpx;
}

.required {
  color: #d33a31;
  margin-left: 6rpx;
}

.form-input {
  height: 80rpx;
  line-height: 80rpx;
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333333;
  box-sizing: border-box;
}

/* ===== 打卡点选项 ===== */
.point-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.point-item.on {
  border-color: #4A90D9;
  background: #eef3f8;
}

.point-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.point-name {
  font-size: 30rpx;
  color: #333333;
}

.point-spell {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.point-check {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 32rpx;
  color: #4A90D9;
  font-weight: bold;
}

.loading-tip {
  font-size: 26rpx;
  color: #999999;
  padding: 20rpx 0;
  text-align: center;
}

/* ===== 有效期选项 ===== */
.duration-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.duration-option {
  padding: 14rpx 34rpx;
  font-size: 28rpx;
  color: #333333;
  background: #f5f6f7;
  border-radius: 28rpx;
}

.duration-option.on {
  background: #4A90D9;
  color: #ffffff;
}

/* ===== 提交按钮 ===== */
.submit-btn {
  margin-top: 50rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: #ffffff;
  background: #4A90D9;
  border-radius: 44rpx;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #9bb4c9;
  color: #ffffff;
}

/* ===== 任务码弹窗 ===== */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.code-pop {
  width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.pop-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.pop-sub {
  font-size: 24rpx;
  color: #999999;
  margin-top: 12rpx;
  text-align: center;
  line-height: 1.5;
}

/* 大字任务码 */
.code-big {
  font-size: 76rpx;
  font-weight: bold;
  color: #4A90D9;
  letter-spacing: 12rpx;
  margin: 40rpx 0;
  font-family: Menlo, Consolas, monospace;
}

.code-copy {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  color: #ffffff;
  background: #4A90D9;
  border-radius: 42rpx;
}

.code-copy::after {
  border: none;
}

.code-close {
  margin-top: 26rpx;
  font-size: 28rpx;
  color: #999999;
  padding: 10rpx 0;
}

/* ===== 深色模式 ===== */
.page.dark .form-card {
  background: #2c2c2e;
}

.page.dark .form-label {
  color: #e5e5e5;
}

.page.dark .form-input {
  background: #3a3a3c;
  color: #e5e5e5;
}

.page.dark .point-item {
  border-color: #3a3a3c;
}

.page.dark .point-item.on {
  border-color: #7fb0dd;
  background: #26384a;
}

.page.dark .point-name {
  color: #e5e5e5;
}

.page.dark .point-spell,
.page.dark .loading-tip {
  color: #9a9a9c;
}

.page.dark .point-check {
  color: #7fb0dd;
}

.page.dark .duration-option {
  background: #3a3a3c;
  color: #e5e5e5;
}

.page.dark .duration-option.on {
  background: #4A90D9;
  color: #ffffff;
}

.page.dark .code-pop {
  background: #2c2c2e;
}

.page.dark .pop-title {
  color: #e5e5e5;
}

.page.dark .pop-sub,
.page.dark .code-close {
  color: #9a9a9c;
}

.page.dark .code-big {
  color: #7fb0dd;
}

/* ===== 字体大小 ===== */
.page.font-lg .form-label { font-size: 31rpx; }
.page.font-lg .form-input { font-size: 33rpx; }
.page.font-lg .point-name { font-size: 33rpx; }

.page.font-xl .form-label { font-size: 34rpx; }
.page.font-xl .form-input { font-size: 36rpx; }
.page.font-xl .point-name { font-size: 36rpx; }
