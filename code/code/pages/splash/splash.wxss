/* 启动封面：全屏品牌展示，深蓝渐变 + 渐入动画 */
.splash {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #1f4e79 0%, #163a5c 60%, #0e2a44 100%);
  color: #ffffff;
}

.logo {
  width: 132rpx;
  height: 132rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 68rpx;
  font-weight: 700;
  margin-bottom: 36rpx;
  animation: pop-in 0.6s ease-out;
}

.title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  animation: fade-up 0.6s ease-out 0.15s both;
}

.subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
  letter-spacing: 2rpx;
  animation: fade-up 0.6s ease-out 0.3s both;
}

.skip {
  position: absolute;
  right: 40rpx;
  bottom: 80rpx;
  padding: 12rpx 36rpx;
  border-radius: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  animation: fade-up 0.6s ease-out 0.5s both;
}

@keyframes pop-in {
  from {
    transform: scale(0.6);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes fade-up {
  from {
    transform: translateY(20rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
