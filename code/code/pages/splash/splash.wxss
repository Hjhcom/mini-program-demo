/* 启动封面：蓝绿渐变 + 北理工元素 */
.splash {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #4A90D9 0%, #3a7d5c 55%, #2E7D32 100%);
  color: #ffffff;
  overflow: hidden;
}

/* 背景水印：1940 */
.bg-watermark {
  position: absolute;
  font-size: 280rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.08);
  letter-spacing: 20rpx;
  top: 10%;
  pointer-events: none;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.25);
  animation: pop-in 0.6s ease-out;
  overflow: hidden;
}

.logo-img {
  width: 100%;
  height: 100%;
}

.title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
  animation: fade-up 0.6s ease-out 0.15s both;
}

.subtitle {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 6rpx;
  animation: fade-up 0.6s ease-out 0.25s both;
}

.desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
  letter-spacing: 2rpx;
  animation: fade-up 0.6s ease-out 0.35s both;
}

.skip {
  position: absolute;
  right: 40rpx;
  bottom: 80rpx;
  padding: 12rpx 36rpx;
  border-radius: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  animation: fade-up 0.6s ease-out 0.5s both;
}

@keyframes pop-in {
  from {
    transform: scale(0.6);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes fade-up {
  from {
    transform: translateY(20rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
