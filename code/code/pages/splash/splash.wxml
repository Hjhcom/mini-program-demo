<!-- pages/splash/splash.wxml —— 启动封面：展示 5 秒后自动跳转首页 -->
<view class="splash">
  <!-- 背景装饰：1940 水印 -->
  <text class="bg-watermark">1940</text>

  <view class="logo">
    <image class="logo-img" src="/images/bit-logo.png" mode="aspectFit" />
  </view>
  <view class="title">{{lang.index.welcomeTitle}}</view>
  <view class="subtitle">{{lang.index.welcomeSlogan}}</view>
  <view class="desc">{{lang.index.welcomeSub}}</view>

  <view class="skip" bindtap="onSkip">{{countdown > 0 ? '跳过 ' + countdown + 's' : '进入'}}</view>
</view>
