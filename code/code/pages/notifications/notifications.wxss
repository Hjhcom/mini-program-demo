/* pages/notifications/notifications.wxss */
.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 20rpx;
  box-sizing: border-box;
}

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 30rpx; color: #666; margin-bottom: 10rpx; }
.empty-sub { font-size: 24rpx; color: #999; }

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  position: relative;
}

.avatar {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #eef3f8;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-img { width: 100%; height: 100%; }
.avatar-ph { font-size: 32rpx; font-weight: bold; color: #4A90D9; }

.body {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.line1 {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}
.name { font-weight: 500; color: #1a1a1a; margin-right: 8rpx; }
.action { color: #555; }
.time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e64340;
  flex-shrink: 0;
  margin-left: 16rpx;
}
