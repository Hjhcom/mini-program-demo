<!-- pages/notifications/notifications.wxml -->
<view class="page {{dark ? 'dark' : ''}} {{fontScale == 'lg' ? 'font-lg' : fontScale == 'xl' ? 'font-xl' : ''}}">
  <image class="page-bg" src="/images/notifications-bg.jpg" mode="aspectFill" />
  <view class="page-mask"></view>

  <view class="content">
  <view class="loading" wx:if="{{loading}}">{{lang.notifications.loading}}</view>

  <view class="empty" wx:elif="{{list.length === 0}}">
    <text class="empty-icon">🔔</text>
    <text class="empty-text">{{lang.notifications.emptyTitle}}</text>
    <text class="empty-sub">{{lang.notifications.emptySub}}</text>
  </view>

  <view class="list" wx:else>
    <view class="item" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="onItemTap">
      <!-- 头像 -->
      <view class="avatar" wx:if="{{item.avatarUrl}}">
        <image class="avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" />
      </view>
      <view class="avatar avatar-ph" wx:else>{{item.avatarText}}</view>

      <!-- 内容 -->
      <view class="body">
        <view class="line1">
          <text class="name">{{item.nickname}}</text>
          <text class="action">{{item.action}}</text>
        </view>
        <view class="time">{{item.timeText}}</view>
      </view>

      <!-- 未读小红点 -->
      <view class="dot" wx:if="{{!item.read}}"></view>
    </view>
  </view>
  </view>
</view>
