<!-- pages/notifications/notifications.wxml -->
<view class="page {{dark ? 'dark' : ''}} {{fontScale == 'lg' ? 'font-lg' : fontScale == 'xl' ? 'font-xl' : ''}}">
  <image class="page-bg" src="/images/notifications-bg.jpg" mode="aspectFill" />
  <view class="page-mask"></view>

  <view class="content">
  <view class="loading" wx:if="{{loading}}">{{lang.notifications.loading}}</view>

  <view class="empty" wx:elif="{{list.length === 0}}">
    <text class="empty-icon">🔔</text>
    <text class="empty-text">{{lang.notifications.emptyTitle}}</text>
    <text class="empty-sub">{{lang.notifications.emptySub}}</text>
  </view>

  <view wx:else>
    <!-- F-19：顶部工具条：一键全部已读 -->
    <view class="toolbar">
      <view class="btn-mark" wx:if="{{hasUnread}}" bindtap="onMarkAllRead">{{lang.notifications.markAllRead}}</view>
    </view>

    <view class="list">
      <view class="item" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}"
            bindtap="onItemTap" bindlongpress="onItemLongPress">
        <!-- 头像 + 类型徽标（F-19：点赞红 / 评论蓝 / 好友绿） -->
        <view class="avatar">
          <image wx:if="{{item.avatarUrl}}" class="avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" />
          <text wx:else class="avatar-ph">{{item.avatarText}}</text>
          <view class="type-badge type-{{item.type}}">
            <text wx:if="{{item.type === 'like'}}">👍</text>
            <text wx:elif="{{item.type === 'comment'}}">💬</text>
            <text wx:else>👥</text>
          </view>
        </view>

      <!-- 内容 -->
      <view class="body">
        <view class="line1">
          <text class="name">{{item.nickname}}</text>
          <text class="action">{{item.action}}</text>
        </view>
        <view class="time">{{item.timeText}}</view>
      </view>

      <!-- 未读小红点 -->
      <view class="dot" wx:if="{{!item.read}}"></view>
    </view>
    </view>
  </view>
  </view>
</view>
