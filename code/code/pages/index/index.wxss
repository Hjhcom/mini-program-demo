/* 首页样式 */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 地图占满上部 */
.map {
  flex: 1;
  width: 100%;
}

/* 待完成任务提示条（在地图与底部面板之间） */
.task-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff6e0;
  border-top: 2rpx solid #f0dfae;
  padding: 18rpx 30rpx;
}

.task-bar-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.task-bar-title {
  font-size: 27rpx;
  color: #8a6100;
  font-weight: bold;
}

.task-bar-desc {
  font-size: 25rpx;
  color: #a67c1a;
  margin-top: 6rpx;
}

.task-bar-arrow {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 40rpx;
  color: #c9a227;
}

/* 深色模式 */
.page.dark .task-bar {
  background: #3d3524;
  border-top-color: #55482b;
}

.page.dark .task-bar-title {
  color: #e8c46a;
}

.page.dark .task-bar-desc {
  color: #c2a75c;
}

/* 字体大小 */
.page.font-lg .task-bar-title { font-size: 30rpx; }
.page.font-lg .task-bar-desc { font-size: 28rpx; }

.page.font-xl .task-bar-title { font-size: 33rpx; }
.page.font-xl .task-bar-desc { font-size: 31rpx; }

/* 底部信息栏 */
.panel {
  min-height: 180rpx;
  background: #ffffff;
  border-top: 2rpx solid #e5e5e5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 30rpx;
  box-sizing: border-box;
}

.tip {
  font-size: 28rpx;
  color: #333;
  text-align: center;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

/* 按钮行 */
.btn-row {
  display: flex;
  gap: 20rpx;
}

.btn {
  width: 200rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0;
  font-size: 28rpx;
  background: #1f4e79;
  color: #ffffff;
  border-radius: 30rpx;
}

.btn::after {
  border: none;
}

/* 录音按钮 */
.btn-record {
  background: #e05a3a;
}

/* 记录按钮（浅色） */
.btn-ghost {
  background: #eef3f8;
  color: #1f4e79;
}

/* 录音中的状态 */
.recording {
  background: #b33a1e;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
