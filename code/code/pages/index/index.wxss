/* ============================================================
   F-07 打卡结果反馈动效
   ⚠️ 这是纯 CSS 动画 + wx:if 的浮层，没有用 wx.createAnimation：
      庆祝层要同时驱动「14 片撒花 + 一张卡片」四个属性各自不同，用 wx.createAnimation
      得维护多套 animation 实例、还得手动清除，不如把参数写进 style、动画交给 CSS。
   ============================================================ */

/* --- 成功：整屏庆祝层 --- */
.celebrate {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 关键：不拦截点击 —— 庆祝的 2.2s 里用户仍能正常操作按钮 */
  pointer-events: none;
}

/* 撒花碎片：从屏幕上方飘落 + 旋转，每片的 left / 延迟 / 时长 / 颜色由 wxml 的 style 单独给 */
.confetti {
  position: absolute;
  top: -60rpx;
  opacity: 0;
  animation-name: confetti-fall;
  animation-timing-function: linear;
  animation-fill-mode: forwards;
}

@keyframes confetti-fall {
  0%   { transform: translateY(0) rotate(0deg); opacity: 0; }
  10%  { opacity: 1; }
  85%  { opacity: 1; }
  100% { transform: translateY(105vh) rotate(720deg); opacity: 0; }
}

/* 居中结果卡（徽章放大弹入：先缩到 0.4，弹过 1.06 再落回 1） */
.result-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 400rpx;
  padding: 40rpx 50rpx;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.18);
  animation: result-pop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes result-pop {
  0%   { transform: scale(0.4); opacity: 0; }
  60%  { transform: scale(1.06); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

.result-icon {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #1f9d6b;
  color: #ffffff;
  font-size: 64rpx;
  line-height: 110rpx;
  text-align: center;
  font-weight: bold;
}

.result-title {
  margin-top: 22rpx;
  font-size: 34rpx;
  font-weight: bold;
  color: #4A90D9;
}

/* 「+10 分」用打卡按钮那套橙红，视觉上把"得分"和"操作"关联起来 */
.result-stars {
  font-size: 44rpx;
  letter-spacing: 6rpx;
  color: #d4a017;
  margin-bottom: 12rpx;
  line-height: 1.2;
}

.result-points {
  margin-top: 8rpx;
  font-size: 52rpx;
  font-weight: bold;
  color: #e05a3a;
}

.result-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666666;
  text-align: center;
}

/* --- 失败：从上方滑入的提示条 ---
   放上方而不是底部，是为了不压住录音按钮：失败后用户八成马上要再念一次。 */
.feedback-bar {
  position: fixed;
  top: 100rpx;
  left: 40rpx;
  right: 40rpx;
  z-index: 998;
  display: flex;
  align-items: flex-start;
  padding: 20rpx 26rpx;
  background: #fdeceb;
  border: 2rpx solid #f3bdb8;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
  pointer-events: none;
  animation: feedback-in 0.28s ease-out both;
}

@keyframes feedback-in {
  0%   { transform: translateY(-140rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.feedback-icon {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #d33a31;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 40rpx;
  text-align: center;
}

.feedback-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.feedback-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #a8271f;
}

.feedback-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #b8544c;
  line-height: 1.45;
}

/* --- 录音按钮抖动（失败时由 JS 加/摘 .shake 类，见 showFailFeedback） --- */
.shake {
  animation: btn-shake 0.5s ease-in-out;
}

@keyframes btn-shake {
  0%, 100% { transform: translateX(0); }
  15% { transform: translateX(-12rpx) rotate(-2deg); }
  30% { transform: translateX(12rpx) rotate(2deg); }
  45% { transform: translateX(-10rpx) rotate(-1.5deg); }
  60% { transform: translateX(10rpx) rotate(1.5deg); }
  80% { transform: translateX(-4rpx); }
}

/* 深色模式（色板与 app.wxss 一致：主文字 #e5e5e5 / 次级 #9a9a9c / 链接 #7fb0dd） */
.page.dark .result-card {
  background: rgba(44, 44, 46, 0.97);
}

.page.dark .result-title {
  color: #8ab4e8;
}

.page.dark .result-sub {
  color: #9a9a9c;
}

.page.dark .feedback-bar {
  background: #3d2422;
  border-color: #6b3a34;
}

.page.dark .feedback-title {
  color: #f0938a;
}

.page.dark .feedback-sub {
  color: #c98b84;
}

/* 字体大小 */
.page.font-lg .result-title { font-size: 38rpx; }
.page.font-lg .result-sub { font-size: 26rpx; }
.page.font-lg .feedback-title { font-size: 30rpx; }
.page.font-lg .feedback-sub { font-size: 26rpx; }

.page.font-xl .result-title { font-size: 42rpx; }
.page.font-xl .result-sub { font-size: 28rpx; }
.page.font-xl .feedback-title { font-size: 32rpx; }
.page.font-xl .feedback-sub { font-size: 28rpx; }


/* ===== 首次进入欢迎引导浮层 ===== */
.guide-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.guide-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 50rpx 40rpx 60rpx;
  box-sizing: border-box;
}
.guide-swiper {
  width: 100%;
  height: 360rpx;
}
.guide-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.guide-emoji {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}
.guide-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}
.guide-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
}
.guide-dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin: 20rpx 0 40rpx;
}
.guide-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #dddddd;
}
.guide-dot.active {
  width: 32rpx;
  border-radius: 6rpx;
  background: #4A90D9;
}
.guide-btn {
  height: 88rpx;
  line-height: 88rpx;
  background: #4A90D9;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 44rpx;
}
.guide-btn::after { border: none; }

/* ===== 开启打卡之旅欢迎屏（校园插画背景） ===== */
.welcome-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #4A90D9;
  z-index: 300;
  overflow: hidden;
}
.welcome-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  width: 100%;
  height: 100%;
}
/* 底部渐变遮罩，保证文字可读 */
.welcome-shade {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg,
    rgba(20,50,90,0.15) 0%,
    rgba(20,50,90,0.05) 40%,
    rgba(15,40,80,0.55) 75%,
    rgba(10,30,65,0.85) 100%);
}

.welcome-inner {
  position: absolute;
  left: 0; right: 0; bottom: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
  animation: welcomeRise 0.6s ease-out;
}

.welcome-title {
  font-size: 64rpx;
  color: #ffffff;
  font-weight: bold;
  letter-spacing: 12rpx;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.3);
}

.welcome-slogan {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  letter-spacing: 6rpx;
  margin-bottom: 20rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.welcome-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.75);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 60rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.welcome-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 420rpx;
  height: 96rpx;
  background: #ffffff;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.25);
}
.welcome-btn::after { border: none; }

.welcome-btn-text {
  font-size: 32rpx;
  color: #2c6aa8;
  font-weight: 500;
  letter-spacing: 2rpx;
}
.welcome-btn-arrow {
  font-size: 40rpx;
  color: #4A90D9;
  margin-left: 12rpx;
  line-height: 1;
}

@keyframes welcomeRise {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}


/* ===== F-17 剧本任务线浮层 ===== */
.route-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: routeMaskIn 0.25s ease;
}

@keyframes routeMaskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.route-panel {
  width: 88%;
  height: 82vh;
  max-height: 82vh;
  background: #f5f7fa;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: routePanelIn 0.3s ease;
}

@keyframes routePanelIn {
  from { transform: translateY(80rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

/* 退出动画：整个遮罩淡出（关闭前 250ms 由 JS 加 route-mask-out 类） */
.route-mask-out {
  animation: routeMaskOut 0.25s ease forwards;
}

@keyframes routeMaskOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

.route-loading {
  padding: 160rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.route-empty {
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.route-empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.route-empty-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}

/* 头部 */
.route-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.route-head-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.route-head-close {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 32rpx;
  color: #888;
  background: #f0f0f0;
  border-radius: 50%;
}

/* 可滚动内容：height:0 + flex:1 让 scroll-view 在 flex 容器里拿到确定高度（否则内容撑开无法滚动） */
.route-body {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 剧本封面 */
.route-cover {
  background: linear-gradient(135deg, #4A90D9, #2E7D32);
  border-radius: 20rpx;
  padding: 28rpx 26rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.route-cover-done {
  background: linear-gradient(135deg, #d4a017, #e05a3a);
}

.route-cover-seal {
  display: inline-block;
  background: rgba(224, 90, 58, 0.92);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(224, 90, 58, 0.35);
}

.route-cover-seal-text {
  letter-spacing: 2rpx;
}

.route-cover-divider {
  display: block;
  text-align: center;
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

.route-cover-desc {
  display: block;
  font-size: 25rpx;
  line-height: 1.7;
  white-space: pre-line;
  margin-bottom: 20rpx;
}

.route-progress-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.route-progress-bar {
  flex: 1;
  height: 14rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 7rpx;
  overflow: hidden;
}

.route-progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 7rpx;
  transition: width 0.4s ease;
}

/* 通关态：进度条变金色并微微发光（精工之魂点亮） */
.route-cover-done .route-progress-fill {
  background: linear-gradient(90deg, #d4a017, #f5c842);
  animation: routeGoldGlow 1.6s ease-in-out infinite;
}

@keyframes routeGoldGlow {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.72; }
}

.route-progress-text {
  margin-left: 16rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

.route-cover-bonus {
  font-size: 22rpx;
  opacity: 0.9;
}

.route-cover-done-text {
  display: block;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
}

/* 四幕剧情 */
.route-acts {
  display: flex;
  flex-direction: column;
}

.route-act {
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-left: 8rpx solid #ddd;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.route-act-done {
  border-left-color: #2E7D32;
}

.route-act-current {
  border-left-color: #4A90D9;
}

.route-act-locked {
  border-left-color: #e0e0e0;
  opacity: 0.65;
}

.route-act-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.route-act-title {
  display: flex;
  align-items: center;
}

.route-act-icon {
  font-size: 30rpx;
  margin-right: 10rpx;
}

.route-act-index {
  font-size: 22rpx;
  color: #4A90D9;
  font-weight: bold;
  background: #eef3f8;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  margin-right: 12rpx;
}

.route-act-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.route-act-done .route-act-index {
  color: #2E7D32;
  background: #e8f5e9;
}

.route-act-done .route-act-name {
  color: #2E7D32;
}

.route-act-current .route-act-name {
  color: #4A90D9;
}

.route-act-status {
  font-size: 22rpx;
  color: #2E7D32;
}

.route-act-status-current {
  color: #4A90D9;
}

.route-act-status-locked {
  color: #999;
}

.route-act-point {
  display: block;
  font-size: 29rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 10rpx;
}

.route-act-story {
  display: block;
  font-size: 24rpx;
  color: #555;
  line-height: 1.7;
  white-space: pre-line;
}

.route-act-spell {
  margin-top: 14rpx;
  background: #f5f7fa;
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  display: inline-block;
}

.route-act-spell-label {
  font-size: 23rpx;
  color: #888;
}

.route-act-spell-text {
  font-size: 25rpx;
  color: #4A90D9;
  font-weight: bold;
}

.route-act-go {
  margin-top: 18rpx;
  background: linear-gradient(135deg, #4A90D9, #3a7bc8);
  color: #fff;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 34rpx;
  font-size: 27rpx;
  font-weight: bold;
}

/* 底部关闭按钮 */
.route-close-btn {
  margin: 8rpx 0 12rpx;
  background: #fff;
  color: #666;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 34rpx;
  font-size: 27rpx;
  border: 1rpx solid #ddd;
}
