/* 首页样式 */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative; /* F-05：给地图上的图例做定位基准 */
}

/* 地图占满上部 */
.map {
  flex: 1;
  width: 100%;
}

/* ===== F-05 图钉颜色图例（浮在地图左上角）===== */
.legend {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  z-index: 10;
  display: flex;
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  padding: 10rpx 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot-official {
  background: #1f4e79;
}

.dot-custom {
  background: #e8842c;
}

.legend-text {
  font-size: 22rpx;
  color: #333333;
}

/* 待完成任务提示条（在地图与底部面板之间） */
.task-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff6e0;
  border-top: 2rpx solid #f0dfae;
  padding: 18rpx 30rpx;
}

.task-bar-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.task-bar-title {
  font-size: 27rpx;
  color: #8a6100;
  font-weight: bold;
}

.task-bar-desc {
  font-size: 25rpx;
  color: #a67c1a;
  margin-top: 6rpx;
}

.task-bar-arrow {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 40rpx;
  color: #c9a227;
}

/* 深色模式 */
.page.dark .task-bar {
  background: #3d3524;
  border-top-color: #55482b;
}

.page.dark .task-bar-title {
  color: #e8c46a;
}

.page.dark .task-bar-desc {
  color: #c2a75c;
}

/* 字体大小 */
.page.font-lg .task-bar-title { font-size: 30rpx; }
.page.font-lg .task-bar-desc { font-size: 28rpx; }

.page.font-xl .task-bar-title { font-size: 33rpx; }
.page.font-xl .task-bar-desc { font-size: 31rpx; }

/* 底部信息栏 */
.panel {
  min-height: 180rpx;
  background: #ffffff;
  border-top: 2rpx solid #e5e5e5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 30rpx;
  box-sizing: border-box;
}

/* 选中点位后：面板变成「半屏卡片」，内容多了可以滚动（文档 3.2.3） */
.panel-sheet {
  max-height: 45vh;
  overflow-y: auto;
  align-items: stretch;
  justify-content: flex-start;
  padding-top: 24rpx;
}

/* ===== 点位信息 ===== */
.point-head {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.point-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.point-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f4e79;
  margin-right: 12rpx;
}

/* F-05：点位来源标签 */
.point-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
  line-height: 1.4;
}

.tag-official {
  color: #1f4e79;
  background: #eef3f8;
}

.tag-mine {
  color: #0f6e56;
  background: #e1f5ee;
}

.tag-player {
  color: #a8600f;
  background: #fdf0e2;
}

.point-spell {
  font-size: 26rpx;
  color: #666;
  margin-top: 6rpx;
}

.point-creator {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

/* F-05：举报入口（面板底部右对齐的小字） */
.report-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.report-link {
  font-size: 22rpx;
  color: #999999;
  padding: 8rpx 12rpx;
  text-decoration: underline;
}

/* ===== F-02 打卡玩家 ===== */
.users-block {
  margin-bottom: 16rpx;
}

.users-title {
  display: block;
  font-size: 26rpx;
  color: #8a6100;
  margin-bottom: 12rpx;
}

.avatar-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.avatar-item {
  width: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-img,
.avatar-ph {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #eef3f8;
}

/* 无头像时的昵称首字占位 */
.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #1f4e79;
  font-weight: bold;
}

.avatar-name {
  width: 96rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #666;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.users-empty {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.tip {
  font-size: 28rpx;
  color: #333;
  text-align: center;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

/* 按钮行 */
.btn-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
}

.btn {
  width: 200rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0;
  font-size: 28rpx;
  background: #1f4e79;
  color: #ffffff;
  border-radius: 30rpx;
}

.btn::after {
  border: none;
}

/* 录音按钮 */
.btn-record {
  background: #e05a3a;
}

/* 记录按钮（浅色） */
.btn-ghost {
  background: #eef3f8;
  color: #1f4e79;
}

/* 录音中的状态 */
.recording {
  background: #b33a1e;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* ===== 深色模式：点位信息与打卡玩家 =====
   注意 .panel / .tip 的深色样式已在 app.wxss 全局定义，这里不要重复，
   只补 F-02 / F-05 新增元素（色板与 app.wxss 保持一致：主文字 #e5e5e5 / 次级 #9a9a9c） */
.page.dark .point-name {
  color: #8ab4e8;
}

.page.dark .point-spell {
  color: #9a9a9c;
}

.page.dark .point-creator {
  color: #77777a;
}

.page.dark .legend {
  background: rgba(44, 44, 46, 0.92);
}

.page.dark .legend-text {
  color: #e5e5e5;
}

.page.dark .dot-official {
  background: #8ab4e8;
}

.page.dark .dot-custom {
  background: #f0a55e;
}

.page.dark .tag-official {
  color: #8ab4e8;
  background: #26384a;
}

.page.dark .tag-mine {
  color: #6fd0ab;
  background: #123b30;
}

.page.dark .tag-player {
  color: #f0a55e;
  background: #3d2d1a;
}

.page.dark .report-link {
  color: #9a9a9c;
}

.page.dark .users-title {
  color: #e8c46a;
}

.page.dark .avatar-img,
.page.dark .avatar-ph {
  background: #3a3a3c;
}

.page.dark .avatar-ph {
  color: #8ab4e8;
}

.page.dark .avatar-name {
  color: #9a9a9c;
}

.page.dark .users-empty {
  color: #9a9a9c;
}

.page.dark .btn-ghost {
  background: #3a3a3c;
  color: #8ab4e8;
}

/* ===== 字体大小：点位信息与打卡玩家 ===== */
.page.font-lg .point-name { font-size: 35rpx; }
.page.font-lg .point-spell { font-size: 29rpx; }
.page.font-lg .users-title { font-size: 29rpx; }
.page.font-lg .users-empty { font-size: 29rpx; }
.page.font-lg .avatar-name { font-size: 24rpx; }
.page.font-lg .point-tag { font-size: 22rpx; }
.page.font-lg .point-creator { font-size: 24rpx; }
.page.font-lg .legend-text { font-size: 24rpx; }
.page.font-lg .report-link { font-size: 24rpx; }

.page.font-xl .point-name { font-size: 38rpx; }
.page.font-xl .point-spell { font-size: 32rpx; }
.page.font-xl .users-title { font-size: 32rpx; }
.page.font-xl .users-empty { font-size: 32rpx; }
.page.font-xl .avatar-name { font-size: 26rpx; }
.page.font-xl .point-tag { font-size: 24rpx; }
.page.font-xl .point-creator { font-size: 26rpx; }
.page.font-xl .legend-text { font-size: 26rpx; }
.page.font-xl .report-link { font-size: 26rpx; }

/* ============================================================
   F-07 打卡结果反馈动效
   ⚠️ 这是纯 CSS 动画 + wx:if 的浮层，没有用 wx.createAnimation：
      庆祝层要同时驱动「14 片撒花 + 一张卡片」四个属性各自不同，用 wx.createAnimation
      得维护多套 animation 实例、还得手动清除，不如把参数写进 style、动画交给 CSS。
   ============================================================ */

/* --- 成功：整屏庆祝层 --- */
.celebrate {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 关键：不拦截点击 —— 庆祝的 2.2s 里用户仍能正常操作按钮 */
  pointer-events: none;
}

/* 撒花碎片：从屏幕上方飘落 + 旋转，每片的 left / 延迟 / 时长 / 颜色由 wxml 的 style 单独给 */
.confetti {
  position: absolute;
  top: -60rpx;
  opacity: 0;
  animation-name: confetti-fall;
  animation-timing-function: linear;
  animation-fill-mode: forwards;
}

@keyframes confetti-fall {
  0%   { transform: translateY(0) rotate(0deg); opacity: 0; }
  10%  { opacity: 1; }
  85%  { opacity: 1; }
  100% { transform: translateY(105vh) rotate(720deg); opacity: 0; }
}

/* 居中结果卡（徽章放大弹入：先缩到 0.4，弹过 1.06 再落回 1） */
.result-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 400rpx;
  padding: 40rpx 50rpx;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.18);
  animation: result-pop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes result-pop {
  0%   { transform: scale(0.4); opacity: 0; }
  60%  { transform: scale(1.06); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

.result-icon {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #1f9d6b;
  color: #ffffff;
  font-size: 64rpx;
  line-height: 110rpx;
  text-align: center;
  font-weight: bold;
}

.result-title {
  margin-top: 22rpx;
  font-size: 34rpx;
  font-weight: bold;
  color: #1f4e79;
}

/* 「+10 分」用打卡按钮那套橙红，视觉上把"得分"和"操作"关联起来 */
.result-points {
  margin-top: 8rpx;
  font-size: 52rpx;
  font-weight: bold;
  color: #e05a3a;
}

.result-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666666;
  text-align: center;
}

/* --- 失败：从上方滑入的提示条 ---
   放上方而不是底部，是为了不压住录音按钮：失败后用户八成马上要再念一次。 */
.feedback-bar {
  position: fixed;
  top: 100rpx;
  left: 40rpx;
  right: 40rpx;
  z-index: 998;
  display: flex;
  align-items: flex-start;
  padding: 20rpx 26rpx;
  background: #fdeceb;
  border: 2rpx solid #f3bdb8;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
  pointer-events: none;
  animation: feedback-in 0.28s ease-out both;
}

@keyframes feedback-in {
  0%   { transform: translateY(-140rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.feedback-icon {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #d33a31;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 40rpx;
  text-align: center;
}

.feedback-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.feedback-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #a8271f;
}

.feedback-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #b8544c;
  line-height: 1.45;
}

/* --- 录音按钮抖动（失败时由 JS 加/摘 .shake 类，见 showFailFeedback） --- */
.shake {
  animation: btn-shake 0.5s ease-in-out;
}

@keyframes btn-shake {
  0%, 100% { transform: translateX(0); }
  15% { transform: translateX(-12rpx) rotate(-2deg); }
  30% { transform: translateX(12rpx) rotate(2deg); }
  45% { transform: translateX(-10rpx) rotate(-1.5deg); }
  60% { transform: translateX(10rpx) rotate(1.5deg); }
  80% { transform: translateX(-4rpx); }
}

/* 深色模式（色板与 app.wxss 一致：主文字 #e5e5e5 / 次级 #9a9a9c / 链接 #7fb0dd） */
.page.dark .result-card {
  background: rgba(44, 44, 46, 0.97);
}

.page.dark .result-title {
  color: #8ab4e8;
}

.page.dark .result-sub {
  color: #9a9a9c;
}

.page.dark .feedback-bar {
  background: #3d2422;
  border-color: #6b3a34;
}

.page.dark .feedback-title {
  color: #f0938a;
}

.page.dark .feedback-sub {
  color: #c98b84;
}

/* 字体大小 */
.page.font-lg .result-title { font-size: 38rpx; }
.page.font-lg .result-sub { font-size: 26rpx; }
.page.font-lg .feedback-title { font-size: 30rpx; }
.page.font-lg .feedback-sub { font-size: 26rpx; }

.page.font-xl .result-title { font-size: 42rpx; }
.page.font-xl .result-sub { font-size: 28rpx; }
.page.font-xl .feedback-title { font-size: 32rpx; }
.page.font-xl .feedback-sub { font-size: 28rpx; }
