  min-width: 0;
  height: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 !important;
  margin: 0 !important;
  line-height: 1.2;
  background: linear-gradient(160deg, #ffffff, #f0f6fd);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(74, 144, 217, 0.08);
  color: #333333;
  text-align: center;
  box-sizing: border-box;
}

.grid-btn::after {
