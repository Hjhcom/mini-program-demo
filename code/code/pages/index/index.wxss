  font-size: 22rpx;
  color: #9c27b0;
  background: #f7ecfa;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.point-spell {
  font-size: 26rpx;
  color: #666;
  margin-top: 6rpx;
}

.point-creator {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

/* F-08：唤起导航（点位信息里的小胶囊按钮） */
.point-actions {
  display: flex;
  margin-top: 14rpx;
}

.point-navigate {
  font-size: 24rpx;
  color: #4A90D9;
  border: 2rpx solid #4A90D9;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

/* F-05：举报入口（面板底部右对齐的小字） */
.report-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.report-link {
  font-size: 22rpx;
  color: #999999;
  padding: 8rpx 12rpx;
  text-decoration: underline;
}

/* ===== F-02 打卡玩家 ===== */
.users-block {
  margin-bottom: 16rpx;
}

.users-title {
  display: block;
  font-size: 26rpx;
  color: #8a6100;
  margin-bottom: 12rpx;
}

.avatar-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.avatar-item {
  width: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-img,
.avatar-ph {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #eef3f8;
}

/* 无头像时的昵称首字占位 */
.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #4A90D9;
  font-weight: bold;
}

.avatar-name {
  width: 96rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #666;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.users-empty {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.tip {
  font-size: 28rpx;
  color: #333;
  text-align: center;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

/* 按钮行 */
.btn-row {
  display: flex;
  flex-direction: column;
  width: 100%;
  gap: 20rpx;
  margin-top: 20rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  font-size: 34rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #6BB6FF 0%, #4A90D9 100%);
  color: #ffffff;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(74, 144, 217, 0.35);
}

.btn::after {
  border: none;
}

/* 录音按钮 */
