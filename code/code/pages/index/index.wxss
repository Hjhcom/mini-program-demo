/* 首页样式 */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative; /* F-05：给地图上的图例做定位基准 */
}

/* 地图占满上部 */
.map {
  flex: 1;
  width: 100%;
}

/* ===== 顶部品牌横幅 ===== */
.top-brand {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #2E7D32 100%);
}

.top-brand-logo {
  font-size: 48rpx;
  margin-right: 18rpx;
}

.top-brand-text {
  display: flex;
  flex-direction: column;
}

.top-brand-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
}

.top-brand-slogan {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
  letter-spacing: 2rpx;
}

/* ===== F-05 图钉颜色图例（浮在地图左上角）===== */
.legend {
  position: absolute;
  top: 180rpx;
  left: 20rpx;
  z-index: 10;
  display: flex;
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  padding: 10rpx 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot-official {
  background: #4A90D9;
}

.dot-custom {
  background: #e8842c;
}

.dot-lit {
  background: #d4a017;
}

.legend-text {
  font-size: 22rpx;
  color: #333333;
}

/* ===== 点亮地图进度条 ===== */
.lit-progress {
  position: absolute;
  top: 230rpx;
  left: 20rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 20rpx;
  padding: 10rpx 20rpx;
  gap: 12rpx;
}

.lit-progress-bar {
  width: 120rpx;
  height: 10rpx;
  background: #e5e5e5;
  border-radius: 5rpx;
  overflow: hidden;
}

.lit-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6BB6FF, #d4a017);
  border-radius: 5rpx;
  transition: width 0.5s ease;
}

.lit-progress-text {
  font-size: 22rpx;
  color: #666;
  white-space: nowrap;
}

/* 深色模式 */
.page.dark .lit-progress {
  background: rgba(44, 44, 46, 0.92);
}

.page.dark .lit-progress-text {
  color: #e5e5e5;
}

.page.dark .lit-progress-bar {
  background: #3a3a3c;
}


/* ===== F-18 UI 打卡点亮波纹 ===== */
.lit-ripple {
  position: absolute;
  top: 40%;
  left: 50%;
  z-index: 8; /* 地图之上、工具层之下 */
  width: 0;
  height: 0;
  pointer-events: none;
}

.lit-ripple-ring {
  position: absolute;
  left: -90rpx;
  top: -90rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(212, 160, 23, 0.85);
  animation: litRing 1.6s ease-out infinite;
}

.lit-ripple-ring.r2 {
  animation-delay: 0.5s;
}

.lit-ripple-ring.r3 {
  animation-delay: 1.0s;
}

@keyframes litRing {
  0% { transform: scale(0.35); opacity: 0.9; }
  100% { transform: scale(6); opacity: 0; }
}

/* 点亮瞬间进度条跳动 */
.lit-progress.bump {
  animation: litBump 0.6s ease;
}

@keyframes litBump {
  0% { transform: scale(1); }
  40% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

/* ===== F-08 地图工具（浮在地图右上角）===== */
.map-tools {
  position: absolute;
  top: 180rpx;
  right: 20rpx;
  z-index: 10;
}

.map-tool {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  padding: 10rpx 20rpx;
}

.map-tool-icon {
  font-size: 24rpx;
  color: #4A90D9;
  margin-right: 6rpx;
}

.map-tool-text {
  font-size: 22rpx;
  color: #333333;
}

/* 待完成任务提示条（在地图与底部面板之间） */
.task-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff6e0;
  border-top: 2rpx solid #f0dfae;
  padding: 18rpx 30rpx;
}

.task-bar-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.task-bar-title {
  font-size: 27rpx;
  color: #8a6100;
  font-weight: bold;
}

.task-bar-desc {
  font-size: 25rpx;
  color: #a67c1a;
  margin-top: 6rpx;
}

.task-bar-arrow {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 40rpx;
  color: #c9a227;
}

/* 深色模式 */
.page.dark .task-bar {
  background: #3d3524;
  border-top-color: #55482b;
}

.page.dark .task-bar-title {
  color: #e8c46a;
}

.page.dark .task-bar-desc {
  color: #c2a75c;
}

/* 字体大小 */
.page.font-lg .task-bar-title { font-size: 30rpx; }
.page.font-lg .task-bar-desc { font-size: 28rpx; }

.page.font-xl .task-bar-title { font-size: 33rpx; }
.page.font-xl .task-bar-desc { font-size: 31rpx; }

/* 底部信息栏 */
.panel {
  min-height: 180rpx;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 30rpx 40rpx;
  box-sizing: border-box;
}

/* 选中点位后：面板变成「半屏卡片」，内容多了可以滚动（文档 3.2.3） */
.panel-sheet {
  max-height: 45vh;
  overflow-y: auto;
  align-items: stretch;
  justify-content: flex-start;
  padding-top: 24rpx;
}

/* ===== 北理工品牌条 ===== */
.brand-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, rgba(74, 144, 217, 0.08) 0%, rgba(46, 125, 50, 0.08) 100%);
  border-radius: 16rpx;
  border-left: 6rpx solid #2E7D32;
}

.brand-logo {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #1a3a5c;
}

.brand-slogan {
  font-size: 22rpx;
  color: #2E7D32;
  margin-top: 4rpx;
  letter-spacing: 2rpx;
}

/* 深色模式 */
.page.dark .brand-bar {
  background: linear-gradient(135deg, rgba(74, 144, 217, 0.15) 0%, rgba(46, 125, 50, 0.15) 100%);
}

.page.dark .brand-title {
  color: #e5e5e5;
}

.page.dark .brand-slogan {
  color: #66bb6a;
}


/* ===== 点位信息 ===== */
.point-head {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.point-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.point-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #4A90D9;
  margin-right: 12rpx;
}

/* F-05：点位来源标签 */
.point-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
  line-height: 1.4;
}

.tag-official {
  color: #4A90D9;
  background: #eef3f8;
}

.tag-mine {
  color: #0f6e56;
  background: #e1f5ee;
}

.tag-player {
  color: #a8600f;
  background: #fdf0e2;
}

.point-stars {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #d4a017;
  background: #fff7e0;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  margin-right: 12rpx;
}

.point-hidden {
  display: inline-block;
