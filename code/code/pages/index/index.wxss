  background: linear-gradient(135deg, #ff8a65 0%, #e05a3a 100%);
  box-shadow: 0 8rpx 20rpx rgba(224, 90, 58, 0.3);
}

/* 次要操作按钮（小胶囊，三列宫格） */
.btn-ghost {
  width: 210rpx !important;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 !important;
  margin: 0 !important;
  font-size: 26rpx;
  font-weight: normal;
  text-align: center;
  background: #f2f5f9;
  color: #4A90D9;
  border-radius: 34rpx;
  box-shadow: none;
}

.btn-ghost::after {
  border: none;
}

/* 次要操作按钮组（三列宫格排列）—— point-create 等页面仍用，保留 */
