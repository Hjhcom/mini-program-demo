  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 30rpx;
  margin-top: 16rpx;
}

/* ===== F-18 UI 首页功能键：2×2 / 2×3 减法宫格 ===== */
.btn-grid {
  margin-top: 16rpx;
}

.grid-sub {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  gap: 16rpx;
}

.grid-btn {
