/* 首页样式 */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 地图占满上部 */
.map {
  flex: 1;
  width: 100%;
}

/* 底部信息栏 */
.panel {
  height: 120rpx;
  background: #ffffff;
  border-top: 2rpx solid #e5e5e5;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.tip {
  font-size: 30rpx;
  color: #333;
  text-align: center;
}
