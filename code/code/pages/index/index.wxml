<!-- 首页结构：地图 + 底部信息栏 -->
<view class="page {{dark ? 'dark' : ''}} {{fontScale == 'lg' ? 'font-lg' : fontScale == 'xl' ? 'font-xl' : ''}}">
  <!-- 北理工品牌横幅 -->
  <view class="top-brand">
    <text class="top-brand-logo">🏛️</text>
    <view class="top-brand-text">
      <text class="top-brand-title">{{lang.index.brandTitle}}</text>
      <text class="top-brand-slogan">{{lang.index.brandSlogan}}</text>
    </view>
  </view>

  <!-- 地图组件：markers 显示打卡点图钉 -->
  <!-- F-08：show-location 会画出「我的位置」蓝点；id 供 MapContext.moveToLocation 使用 -->
  <map class="map"
       id="map"
       longitude="{{center.longitude}}"
       latitude="{{center.latitude}}"
       scale="{{scale}}"
       markers="{{markers}}"
       language="{{mapLang}}"
       show-location
       bindmarkertap="onMarkerTap"></map>

  <!-- F-08：地图工具（右上角浮层）—— 回到我的位置 -->
  <view class="map-tools">
    <view class="map-tool" bindtap="onLocateTap">
      <text class="map-tool-icon">◎</text>
      <text class="map-tool-text">{{lang.index.locate}}</text>
    </view>
  </view>

  <!-- F-05：图钉颜色图例（官方 / 玩家自建） -->
  <view class="legend" wx:if="{{isLoggedIn}}">
    <view class="legend-item">
      <view class="legend-dot dot-official"></view>
      <text class="legend-text">{{lang.index.typeOfficial}}</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot dot-custom"></view>
      <text class="legend-text">{{lang.index.typePlayer}}</text>
    </view>
  </view>

  <!-- 点亮地图进度条 -->
  <view class="lit-progress" wx:if="{{isLoggedIn && totalCount > 0}}">
    <view class="lit-progress-bar">
      <view class="lit-progress-fill" style="width: {{visitedCount / totalCount * 100}}%"></view>
    </view>
    <text class="lit-progress-text">已点亮 {{visitedCount}}/{{totalCount}}</text>
  </view>

  <!-- 待完成任务提示条（指派给我、进行中、未过期） -->
  <view class="task-bar" wx:if="{{pendingTask}}" bindtap="goTask">
    <view class="task-bar-main">
      <text class="task-bar-title">{{lang.index.taskBarTitle}}</text>
      <text class="task-bar-desc">{{taskBarDesc}}</text>
    </view>
    <text class="task-bar-arrow">›</text>
  </view>

  <!-- 底部信息栏 -->
  <!-- 未登录：先登录才能打卡 -->
  <view class="panel" wx:if="{{!isLoggedIn}}">
    <view class="tip">{{lang.index.tipLoginFirst}}</view>
    <view class="btn-row">
      <button class="btn" bindtap="checkIn">{{lang.index.checkIn}}</button>
      <button class="btn" bindtap="goLogin">{{lang.index.goLogin}}</button>
    </view>
  </view>

  <!-- 已登录：点位信息 / 打卡玩家 / 提示文字 / 按钮区 -->
  <view class="panel {{selectedPoint ? 'panel-sheet' : ''}}" wx:else>
    <!-- 选中点位：点位名 + 类型标签 + 咒语 -->
    <view class="point-head" wx:if="{{selectedPoint}}">
      <view class="point-title-row">
        <text class="point-name">{{selectedPoint.name}}</text>
        <!-- F-05：点位来源标签（判断在服务端做成布尔值，前端拿不到 openid） -->
        <text class="point-tag tag-official" wx:if="{{selectedPoint.isOfficial}}">{{lang.index.typeOfficial}}</text>
        <text class="point-tag tag-mine" wx:elif="{{selectedPoint.isMine}}">{{lang.index.typeMine}}</text>
        <text class="point-tag tag-player" wx:else>{{lang.index.typePlayer}}</text>
      </view>
      <text class="point-spell">{{lang.index.spellLabel}}{{selectedPoint.spell}}</text>
      <text class="point-creator" wx:if="{{selectedPoint.creatorNickname}}">
        {{lang.index.creatorPrefix}}{{selectedPoint.creatorNickname}}
      </text>
      <!-- F-08：唤起导航（交给微信内置地图，用户可直接点「导航」） -->
      <view class="point-actions">
        <text class="point-navigate" bindtap="onNavigateTap">{{lang.index.navigate}}</text>
      </view>
    </view>

    <!-- F-02：该点位的打卡玩家（人数 + 头像墙） -->
    <view class="users-block" wx:if="{{selectedPoint}}">
      <text class="users-title" wx:if="{{usersTitle}}">{{usersTitle}}</text>
      <view class="avatar-row" wx:if="{{recentUsers.length > 0}}">
        <view class="avatar-item" wx:for="{{recentUsers}}" wx:key="index">
          <image class="avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" wx:if="{{item.avatarUrl}}" />
          <view class="avatar-ph" wx:else>{{item.initial}}</view>
          <text class="avatar-name">{{item.nickname}}</text>
        </view>
      </view>
      <text class="users-empty" wx:elif="{{usersLoading}}">{{lang.index.usersLoading}}</text>
      <text class="users-empty" wx:else>{{lang.index.usersEmpty}}</text>
    </view>

    <view class="tip">{{tip}}</view>
    <view class="btn-row">
      <button class="btn" bindtap="checkIn">{{lang.index.checkIn}}</button>
      <button wx:if="{{inRange}}" class="btn btn-record {{recording ? 'recording' : ''}} {{shake ? 'shake' : ''}}"
              bindtap="onRecordTap">{{recording ? lang.index.recording : lang.index.spell}}</button>
      <view class="btn-ghost-row">
        <button wx:if="{{selectedPoint}}" class="btn btn-ghost" bindtap="goCreateTask">{{lang.index.createTaskForFriend}}</button>
        <button class="btn btn-ghost" bindtap="goCreatePoint">{{lang.index.createPoint}}</button>
        <button class="btn btn-ghost" bindtap="goPointList">{{lang.index.pointList}}</button>
        <button class="btn btn-ghost" bindtap="goRanking">{{lang.index.ranking}}</button>
        <button class="btn btn-ghost" bindtap="goRecords">{{lang.index.records}}</button>
      </view>
    </view>

    <!-- F-05：举报入口（仅别人创建的玩家点位显示） -->
    <view class="report-row" wx:if="{{canReport}}">
      <text class="report-link" bindtap="onReportTap">{{lang.index.report}}</text>
    </view>
  </view>

  <!-- ===== F-07 打卡结果反馈动效 ===== -->
  <!-- 成功：整屏撒花 + 居中结果卡（徽章放大弹入 + 底部 +10 分）。
       pointer-events:none 让庆祝层不挡按钮；2.2s 后由 JS 自动收起。 -->
  <view class="celebrate" wx:if="{{celebrate}}">
    <view class="confetti" wx:for="{{confetti}}" wx:key="id"
          style="left:{{item.left}}%;animation-delay:{{item.delay}}s;animation-duration:{{item.dur}}s;background:{{item.color}};width:{{item.w}}rpx;height:{{item.h}}rpx;border-radius:{{item.round ? '50%' : '4rpx'}}"></view>
    <view class="result-card">
      <view class="result-icon">✓</view>
      <text class="result-title">{{celebrateTitle}}</text>
      <text class="result-points">{{celebratePoints}}</text>
      <text class="result-sub">{{celebrateSub}}</text>
    </view>
  </view>

  <!-- 失败：从上方滑入的红色提示条（念错 / 任务校验失败 / 网络异常都会走到这里） -->
  <view class="feedback-bar" wx:if="{{feedback}}">
    <text class="feedback-icon">✕</text>
    <view class="feedback-text">
      <text class="feedback-title">{{feedback.title}}</text>
      <text class="feedback-sub" wx:if="{{feedback.sub}}">{{feedback.sub}}</text>
    </view>
  </view>

  <!-- 首次进入欢迎引导浮层 -->
  <view class="guide-mask" wx:if="{{showGuide}}">
    <view class="guide-sheet">
      <swiper class="guide-swiper" current="{{guideIndex}}" bindchange="onGuideChange">
        <swiper-item>
          <view class="guide-page">
            <text class="guide-emoji">🗺️</text>
            <text class="guide-title">找到打卡点</text>
            <text class="guide-desc">地图上的图钉就是打卡点，走到附近才能解锁打卡</text>
          </view>
        </swiper-item>
        <swiper-item>
          <view class="guide-page">
            <text class="guide-emoji">🎤</text>
            <text class="guide-title">念出咒语</text>
            <text class="guide-desc">对着手机念出该点的咒语，语音识别相似度 ≥ 80% 才算成功</text>
          </view>
        </swiper-item>
        <swiper-item>
          <view class="guide-page">
            <text class="guide-emoji">👥</text>
            <text class="guide-title">和好友一起玩</text>
            <text class="guide-desc">打卡自动生成动态，点赞评论、互相 PK，点亮校园地图</text>
          </view>
        </swiper-item>
      </swiper>

      <view class="guide-dots">
        <view class="guide-dot {{guideIndex == 0 ? 'active' : ''}}"></view>
        <view class="guide-dot {{guideIndex == 1 ? 'active' : ''}}"></view>
        <view class="guide-dot {{guideIndex == 2 ? 'active' : ''}}"></view>
      </view>

      <button class="guide-btn" bindtap="onGuideNext">
        {{guideIndex < 2 ? '下一步' : '开始探索'}}
      </button>
    </view>
  </view>

  <!-- 开启打卡之旅欢迎屏（校园插画背景） -->
  <view class="welcome-mask" wx:if="{{showWelcome}}">
    <image class="welcome-bg" src="/images/welcome-bg.jpg" mode="aspectFill" />
    <view class="welcome-shade"></view>

    <view class="welcome-inner">
      <text class="welcome-title">依声游理</text>
      <text class="welcome-slogan">德以明理 · 学以精工</text>
      <text class="welcome-sub">到点打卡，念出咒语，畅游北理</text>
      <button class="welcome-btn" bindtap="onEnterTap">
        <text class="welcome-btn-text">开启打卡之旅</text>
        <text class="welcome-btn-arrow">›</text>
      </button>
    </view>
  </view>

</view>
