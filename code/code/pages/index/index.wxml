<!-- 首页结构：地图 + 底部信息栏 -->
<view class="page {{dark ? 'dark' : ''}} {{fontScale == 'lg' ? 'font-lg' : fontScale == 'xl' ? 'font-xl' : ''}}">
  <!-- 北理工品牌横幅 -->
  <view class="top-brand">
    <text class="top-brand-logo">🏛️</text>
    <view class="top-brand-text">
      <text class="top-brand-title">{{lang.index.brandTitle}}</text>
      <text class="top-brand-slogan">{{lang.index.brandSlogan}}</text>
    </view>
  </view>

  <!-- 地图组件：markers 显示打卡点图钉 -->
  <!-- F-08：show-location 会画出「我的位置」蓝点；id 供 MapContext.moveToLocation 使用 -->
  <map class="map"
       id="map"
       longitude="{{center.longitude}}"
       latitude="{{center.latitude}}"
       scale="{{scale}}"
       markers="{{markers}}"
       language="{{mapLang}}"
       show-location
       bindmarkertap="onMarkerTap"></map>

  <!-- F-18 UI：打卡成功点亮波纹（金色圆环从地图中部扩散） -->
  <view class="lit-ripple" wx:if="{{litRipple}}">
    <view class="lit-ripple-ring r1"></view>
    <view class="lit-ripple-ring r2"></view>
    <view class="lit-ripple-ring r3"></view>
  </view>

  <!-- F-08：地图工具（右上角浮层）—— 回到我的位置 -->
  <view class="map-tools">
    <view class="map-tool" bindtap="onLocateTap">
      <text class="map-tool-icon">◎</text>
      <text class="map-tool-text">{{lang.index.locate}}</text>
    </view>
  </view>

  <!-- F-05：图钉颜色图例（官方 / 玩家自建） -->
  <view class="legend" wx:if="{{isLoggedIn}}">
    <view class="legend-item">
      <view class="legend-dot dot-official"></view>
      <text class="legend-text">{{lang.index.typeOfficial}}</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot dot-custom"></view>
      <text class="legend-text">{{lang.index.typePlayer}}</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot dot-lit"></view>
      <text class="legend-text">{{lang.index.typeLit}}</text>
    </view>
  </view>

  <!-- 点亮地图进度条 -->
  <view class="lit-progress {{litRipple ? 'bump' : ''}}" wx:if="{{isLoggedIn && totalCount > 0}}">
    <view class="lit-progress-bar">
      <view class="lit-progress-fill" style="width: {{visitedCount / totalCount * 100}}%"></view>
    </view>
    <text class="lit-progress-text">{{litProgressText}}</text>
  </view>

  <!-- 待完成任务提示条（指派给我、进行中、未过期） -->
  <view class="task-bar" wx:if="{{pendingTask}}" bindtap="goTask">
    <view class="task-bar-main">
      <text class="task-bar-title">{{lang.index.taskBarTitle}}</text>
      <text class="task-bar-desc">{{taskBarDesc}}</text>
    </view>
    <text class="task-bar-arrow">›</text>
  </view>

  <!-- 底部信息栏 -->
  <!-- 未登录：先登录才能打卡 -->
  <view class="panel" wx:if="{{!isLoggedIn}}">
    <view class="tip">{{lang.index.tipLoginFirst}}</view>
    <view class="btn-row">
      <button class="btn" bindtap="checkIn">{{lang.index.checkIn}}</button>
      <button class="btn" bindtap="goLogin">{{lang.index.goLogin}}</button>
    </view>
  </view>

  <!-- 已登录：点位信息 / 打卡玩家 / 提示文字 / 按钮区 -->
  <view class="panel {{selectedPoint ? 'panel-sheet' : ''}}" wx:else>
    <!-- 选中点位：点位名 + 类型标签 + 咒语 -->
    <view class="point-head" wx:if="{{selectedPoint}}">
      <view class="point-title-row">
        <text class="point-name">{{selectedPoint.name}}</text>
        <!-- F-05：点位来源标签（判断在服务端做成布尔值，前端拿不到 openid） -->
        <text class="point-tag tag-official" wx:if="{{selectedPoint.isOfficial}}">{{lang.index.typeOfficial}}</text>
        <text class="point-tag tag-mine" wx:elif="{{selectedPoint.isMine}}">{{lang.index.typeMine}}</text>
        <text class="point-tag tag-player" wx:else>{{lang.index.typePlayer}}</text>
      </view>
      <text class="point-spell">{{lang.index.spellLabel}}{{selectedPoint.spell}}</text>
      <!-- F-13：该点位我的最高星级（收集进度） -->
      <text class="point-stars" wx:if="{{selectedPoint.bestStars > 0}}">⭐ × {{selectedPoint.bestStars}}</text>
      <text class="point-hidden" wx:if="{{selectedPoint.hasHidden}}">{{lang.index.hiddenTag}}</text>
      <text class="point-creator" wx:if="{{selectedPoint.creatorNickname}}">
        {{lang.index.creatorPrefix}}{{selectedPoint.creatorNickname}}
      </text>
      <!-- F-08：唤起导航（交给微信内置地图，用户可直接点「导航」） -->
      <view class="point-actions">
        <text class="point-navigate" bindtap="onNavigateTap">{{lang.index.navigate}}</text>
      </view>
    </view>

    <!-- F-02：该点位的打卡玩家（人数 + 头像墙） -->
    <view class="users-block" wx:if="{{selectedPoint}}">
      <text class="users-title" wx:if="{{usersTitle}}">{{usersTitle}}</text>
      <view class="avatar-row" wx:if="{{recentUsers.length > 0}}">
        <view class="avatar-item" wx:for="{{recentUsers}}" wx:key="index">
          <image class="avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" wx:if="{{item.avatarUrl}}" />
          <view class="avatar-ph" wx:else>{{item.initial}}</view>
          <text class="avatar-name">{{item.nickname}}</text>
        </view>
      </view>
      <text class="users-empty" wx:elif="{{usersLoading}}">{{lang.index.usersLoading}}</text>
      <text class="users-empty" wx:else>{{lang.index.usersEmpty}}</text>
    </view>

    <view class="tip">{{tip}}</view>
    <view class="btn-row">
      <button class="btn" bindtap="checkIn">{{lang.index.checkIn}}</button>
      <button wx:if="{{inRange}}" class="btn btn-record {{recording ? 'recording' : ''}} {{shake ? 'shake' : ''}}"
              bindtap="onRecordTap">{{recording ? lang.index.recording : lang.index.spell}}</button>
      <view class="btn-grid">
        <view class="grid-sub">
          <!-- 剧本任务线：渐变高亮格 -->
          <button class="grid-btn grid-btn-route" bindtap="goRoute">
            <text class="grid-icon">📖</text>
            <text class="grid-text">{{lang.index.routeEntry}}</text>
          </button>
          <button class="grid-btn" bindtap="goRanking">
            <text class="grid-icon">🏆</text>
            <text class="grid-text">{{lang.index.ranking}}</text>
          </button>
          <button class="grid-btn" bindtap="goPointList">
            <text class="grid-icon">📍</text>
            <text class="grid-text">{{lang.index.pointList}}</text>
          </button>
          <button class="grid-btn" bindtap="goRecords">
            <text class="grid-icon">📝</text>
            <text class="grid-text">{{lang.index.records}}</text>
          </button>
          <!-- 选中点位后追加：自动凑成 2×3 完整方阵 -->
          <button wx:if="{{selectedPoint}}" class="grid-btn" bindtap="goPointDetail">
            <text class="grid-icon">🗺️</text>
            <text class="grid-text">{{lang.index.pointDetail}}</text>
          </button>
          <button wx:if="{{selectedPoint}}" class="grid-btn" bindtap="goCreateTask">
            <text class="grid-icon">📋</text>
            <text class="grid-text">{{lang.index.createTaskForFriend}}</text>
          </button>
        </view>
      </view>
    </view>

    <!-- F-05：举报入口（仅别人创建的玩家点位显示） -->
    <view class="report-row" wx:if="{{canReport}}">
      <text class="report-link" bindtap="onReportTap">{{lang.index.report}}</text>
    </view>
  </view>

  <!-- ===== F-07 打卡结果反馈动效 ===== -->
  <!-- 成功：整屏撒花 + 居中结果卡（徽章放大弹入 + 底部 +10 分）。
       pointer-events:none 让庆祝层不挡按钮；2.2s 后由 JS 自动收起。 -->
  <view class="celebrate" wx:if="{{celebrate}}">
    <view class="confetti" wx:for="{{confetti}}" wx:key="id"
          style="left:{{item.left}}%;animation-delay:{{item.delay}}s;animation-duration:{{item.dur}}s;background:{{item.color}};width:{{item.w}}rpx;height:{{item.h}}rpx;border-radius:{{item.round ? '50%' : '4rpx'}}"></view>
    <view class="result-card">
      <view class="result-icon">✓</view>
      <text class="result-title">{{celebrateTitle}}</text>
      <!-- F-13：星级（1~3 星；隐藏咒语带 ✨） -->
      <text class="result-stars" wx:if="{{celebrateStars}}">{{celebrateStars}}</text>
      <text class="result-points">{{celebratePoints}}</text>
      <text class="result-sub">{{celebrateSub}}</text>
    </view>
  </view>

  <!-- 失败：从上方滑入的红色提示条（念错 / 任务校验失败 / 网络异常都会走到这里） -->
  <view class="feedback-bar" wx:if="{{feedback}}">
    <text class="feedback-icon">✕</text>
    <view class="feedback-text">
      <text class="feedback-title">{{feedback.title}}</text>
      <text class="feedback-sub" wx:if="{{feedback.sub}}">{{feedback.sub}}</text>
    </view>
  </view>

  <!-- 首次进入欢迎引导浮层 -->
  <view class="guide-mask" wx:if="{{showGuide}}">
    <view class="guide-sheet">
      <swiper class="guide-swiper" current="{{guideIndex}}" bindchange="onGuideChange">
        <swiper-item>
          <view class="guide-page">
            <text class="guide-emoji">🗺️</text>
            <text class="guide-title">{{lang.index.guide1Title}}</text>
            <text class="guide-desc">{{lang.index.guide1Desc}}</text>
          </view>
        </swiper-item>
        <swiper-item>
          <view class="guide-page">
            <text class="guide-emoji">🎤</text>
            <text class="guide-title">{{lang.index.guide2Title}}</text>
            <text class="guide-desc">{{lang.index.guide2Desc}}</text>
          </view>
        </swiper-item>
        <swiper-item>
          <view class="guide-page">
            <text class="guide-emoji">👥</text>
            <text class="guide-title">{{lang.index.guide3Title}}</text>
            <text class="guide-desc">{{lang.index.guide3Desc}}</text>
          </view>
        </swiper-item>
      </swiper>

      <view class="guide-dots">
        <view class="guide-dot {{guideIndex == 0 ? 'active' : ''}}"></view>
        <view class="guide-dot {{guideIndex == 1 ? 'active' : ''}}"></view>
        <view class="guide-dot {{guideIndex == 2 ? 'active' : ''}}"></view>
      </view>

      <button class="guide-btn" bindtap="onGuideNext">
        {{guideIndex < 2 ? lang.index.guideNext : lang.index.guideEnter}}
      </button>
    </view>
  </view>

  <!-- 开启打卡之旅欢迎屏（校园插画背景） -->
  <view class="welcome-mask" wx:if="{{showWelcome}}">
    <image class="welcome-bg" src="/images/welcome-bg.jpg" mode="aspectFill" />
    <view class="welcome-shade"></view>

    <view class="welcome-inner">
      <text class="welcome-title">{{lang.index.welcomeTitle}}</text>
      <text class="welcome-slogan">{{lang.index.welcomeSlogan}}</text>
      <text class="welcome-sub">{{lang.index.welcomeSub}}</text>
      <button class="welcome-btn" bindtap="onEnterTap">
        <text class="welcome-btn-text">{{lang.index.welcomeBtn}}</text>
        <text class="welcome-btn-arrow">›</text>
      </button>
    </view>
  </view>

  <!-- F-17 剧本任务线浮层：点「开启打卡之旅」/「剧本任务线」按钮弹出，手动关闭 -->
  <view class="route-mask {{routeClosing ? 'route-mask-out' : ''}}" wx:if="{{showRouteMask}}" catchtouchmove="noop">
    <view class="route-panel">
      <!-- 加载中 -->
      <view class="route-loading" wx:if="{{routeLoading}}">
        <text>{{lang.routes.loading}}</text>
      </view>
      <!-- 无线路 / 加载失败 -->
      <block wx:elif="{{!routeData}}">
        <view class="route-empty">
          <text class="route-empty-icon">{{routeError ? '⚠️' : '📜'}}</text>
          <text class="route-empty-text">{{routeError === 'load' ? lang.routes.errLoad : (routeError || lang.routes.none)}}</text>
          <view class="route-close-btn" bindtap="{{routeError ? 'retryRoute' : 'closeRouteMask'}}">{{routeError ? lang.routes.retry : lang.routes.close}}</view>
        </view>
      </block>
      <!-- 线路内容 -->
      <block wx:else>
        <view class="route-head">
          <text class="route-head-title">📖 {{routeData.name}}</text>
          <text class="route-head-close" bindtap="closeRouteMask">✕</text>
        </view>

        <scroll-view scroll-y class="route-body">
          <!-- 剧本封面 + 进度 -->
          <view class="route-cover {{routeProgress.completed ? 'route-cover-done' : ''}}">
            <!-- 1940 延安元素：红色印章徽章 -->
            <view class="route-cover-seal">
              <text class="route-cover-seal-text">{{lang.routes.coverSeal}}</text>
            </view>
            <text class="route-cover-desc">{{routeData.desc}}</text>
            <view class="route-progress-row">
              <view class="route-progress-bar">
                <view class="route-progress-fill"
                      style="width: {{routeProgress.completed ? 100 : (routeProgress.currentIndex / routeData.total * 100)}}%"></view>
              </view>
              <text class="route-progress-text">{{routeProgress.completed ? lang.routes.done : (routeProgress.currentIndex + ' / ' + routeData.total)}}</text>
            </view>
            <text class="route-cover-bonus" wx:if="{{!routeProgress.completed}}">{{routeData.bonusTipText}}</text>
            <text class="route-cover-done-text" wx:if="{{routeProgress.completed}}">🎉 {{lang.routes.routeDone}}</text>
            <text class="route-cover-divider" wx:if="{{!routeProgress.completed}}">{{lang.routes.coverDivider}}</text>
          </view>

          <!-- 四幕剧情 -->
          <view class="route-acts">
            <view class="route-act {{item.status === 'done' ? 'route-act-done' : (item.status === 'current' ? 'route-act-current' : 'route-act-locked')}}"
                  wx:for="{{routeActs}}" wx:key="index">
              <view class="route-act-head">
                <view class="route-act-title">
                  <text class="route-act-icon">{{item.actIcon}}</text>
                  <text class="route-act-index">{{lang.routes.act}}{{index + 1}}</text>
                  <text class="route-act-name">{{item.actName}}</text>
                </view>
                <text class="route-act-status" wx:if="{{item.status === 'done'}}">✓ {{lang.routes.stepDone}}</text>
                <text class="route-act-status route-act-status-current" wx:elif="{{item.status === 'current'}}">▶ {{lang.routes.stepCurrent}}</text>
                <text class="route-act-status route-act-status-locked" wx:else>🔒 {{lang.routes.stepLocked}}</text>
              </view>
              <text class="route-act-point">{{item.pointName}}</text>
              <text class="route-act-story">{{item.story}}</text>
              <view class="route-act-spell" wx:if="{{item.status !== 'locked'}}">
                <text class="route-act-spell-label">{{lang.routes.spellLabel}}</text>
                <text class="route-act-spell-text">{{item.spell}}</text>
              </view>
              <view class="route-act-go" wx:if="{{item.status === 'current'}}" bindtap="onRouteGoCheckin" data-point="{{item.pointId}}">
                {{lang.routes.goCheckin}}
              </view>
            </view>
          </view>

          <!-- 底部手动关闭 -->
          <view class="route-close-btn" bindtap="closeRouteMask">{{lang.routes.close}}</view>
        </scroll-view>
      </block>
    </view>
  </view>

</view>
