<!-- pages/agreement/agreement.wxml —— 用户协议 / 隐私政策 -->
<view class="page {{dark ? 'dark' : ''}} {{fontScale == 'lg' ? 'font-lg' : fontScale == 'xl' ? 'font-xl' : ''}}">
  <scroll-view scroll-y class="content">
    <view class="doc-title">{{docTitle}}</view>
    <view class="doc-update">{{lang.agreement.updated}}</view>

    <view class="section" wx:for="{{sections}}" wx:key="h">
      <view class="section-h">{{item.h}}</view>
      <view class="section-c" wx:for="{{item.c}}" wx:for-item="para" wx:key="*this">{{para}}</view>
    </view>
  </scroll-view>
</view>
