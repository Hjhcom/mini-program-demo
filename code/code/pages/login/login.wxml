<!-- 登录页：微信一键登录 + 手机号授权登录 -->
<view class="page">
  <view class="header">
    <view class="logo">声</view>
    <view class="title">声控打卡游戏</view>
    <view class="subtitle">登录后开启你的打卡之旅</view>
  </view>

  <view class="login-box">
    <!-- 微信一键登录：静默登录，微信自动识别身份（openid），无需弹窗 -->
    <button class="btn btn-wechat" loading="{{loading}}" disabled="{{loading}}" bindtap="onWechatLogin">微信一键登录</button>

    <!-- 手机号授权登录：点击后微信弹出手机号授权框（需小程序已完成微信认证，个人主体不可用） -->
    <button class="btn btn-phone" open-type="getPhoneNumber" bindgetphonenumber="onGetPhone" disabled="{{loading}}">手机号授权登录</button>
  </view>

  <view class="footer">登录即代表同意《用户协议》与《隐私政策》</view>
</view>
