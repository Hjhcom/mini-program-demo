<!-- pages/login/login.wxml —— 登录方式选择 -->
<view class="page {{dark ? 'dark' : ''}} {{fontScale == 'lg' ? 'font-lg' : fontScale == 'xl' ? 'font-xl' : ''}}">

  <!-- 品牌区 -->
  <view class="brand">
    <view class="logo">声</view>
    <view class="brand-title">{{lang.common.appName}}</view>
    <view class="brand-sub">{{lang.login.brandSub}}</view>
  </view>

  <!-- 三种登录方式 -->
  <view class="login-ways">
    <button class="way wechat" bindtap="loginWithWechat">
      <view class="way-icon">微</view>
      <text>{{lang.login.wechat}}</text>
    </button>

    <button class="way phone" bindtap="openSmsLogin">
      <view class="way-icon">机</view>
      <text>{{lang.login.phone}}</text>
    </button>

    <button class="way guest" bindtap="loginAsGuest">
      <view class="way-icon">客</view>
      <text>{{lang.login.guest}}</text>
    </button>
  </view>

  <!-- 协议勾选 -->
  <view class="agree-row" bindtap="toggleAgree">
    <view class="checkbox {{agreed ? 'checked' : ''}}">
      <text wx:if="{{agreed}}" class="check-mark">✓</text>
    </view>
    <text class="agree-text">{{lang.login.agreePrefix}}</text>
    <text class="link" catchtap="onAgreementTap" data-type="user">{{lang.login.agreeUser}}</text>
    <text class="agree-text">{{lang.login.agreeAnd}}</text>
    <text class="link" catchtap="onAgreementTap" data-type="privacy">{{lang.login.agreePrivacy}}</text>
  </view>

  <!-- 手机号验证码登录弹窗 -->
  <view class="mask" wx:if="{{showSms}}">
    <view class="profile-pop">
      <view class="pop-title">{{lang.login.phoneTitle}}</view>
      <view class="pop-sub">{{lang.login.phoneSub}}</view>

      <view class="sms-row">
        <input class="sms-input" type="number" maxlength="11" placeholder="{{lang.login.phonePlaceholder}}" value="{{phone}}" bindinput="onPhoneInput" />
        <button class="code-btn {{canSend ? '' : 'code-disabled'}}" disabled="{{!canSend}}" bindtap="onSendCode">{{ canSend ? lang.login.getCode : resendText }}</button>
      </view>

      <input class="sms-input sms-code-input" type="number" maxlength="6" placeholder="{{lang.login.codePlaceholder}}" value="{{code}}" bindinput="onCodeInput" />

      <view class="pop-actions">
        <button class="pop-btn cancel" bindtap="closeSmsLogin">{{lang.login.cancel}}</button>
        <button class="pop-btn confirm" bindtap="onSmsLogin">{{lang.login.login}}</button>
      </view>
    </view>
  </view>

  <!-- 头像昵称授权弹窗（微信登录时弹出） -->
  <view class="mask" wx:if="{{showProfile}}">
    <view class="profile-pop">
      <view class="pop-title">{{lang.login.profileTitle}}</view>
      <view class="pop-sub">{{lang.login.profileSub}}</view>

      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-placeholder">+</view>
      </button>
      <view class="avatar-tip">{{lang.login.chooseAvatar}}</view>

      <input class="nick-input" type="nickname" placeholder="{{lang.login.nickPlaceholder}}" value="{{nickname}}" bindchange="onNicknameChange" bindblur="onNicknameChange" />

      <view class="pop-actions">
        <button class="pop-btn cancel" bindtap="onCancelProfile">{{lang.login.later}}</button>
        <button class="pop-btn confirm" bindtap="onConfirmProfile">{{lang.login.finish}}</button>
      </view>
    </view>
  </view>

</view>
