/* 登录页样式 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1f4e79 0%, #2d6a9f 55%, #f7f8fa 55%);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  padding: 0 60rpx;
}

.header {
  margin-top: 220rpx;
  text-align: center;
  color: #fff;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  margin: 0 auto 30rpx;
  background: #ffffff;
  color: #1f4e79;
  font-size: 60rpx;
  font-weight: bold;
  text-align: center;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.title {
  font-size: 44rpx;
  font-weight: bold;
}

.subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  opacity: 0.85;
}

.login-box {
  width: 100%;
  margin-top: 140rpx;
}

.btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  font-size: 32rpx;
  margin-bottom: 30rpx;
}

.btn-wechat {
  background: #07c160;
  color: #ffffff;
}

.btn-wechat[disabled] {
  background: #07c160;
  color: #ffffff;
  opacity: 0.7;
}

.btn-phone {
  background: #ffffff;
  color: #333333;
  border: 2rpx solid #dcdcdc;
}

.footer {
  position: fixed;
  bottom: 60rpx;
  font-size: 24rpx;
  color: #999999;
  text-align: center;
}
