/* 登录页样式（风格与全局一致：主色 #4A90D9） */
.page {
  min-height: 100vh;
  background: #f5f6f7;
  display: flex;
  flex-direction: column;
}

/* 品牌区 */
.brand {
  padding: 100rpx 0 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #4A90D9;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  text-align: center;
  border-radius: 32rpx;
  background: #ffffff;
  color: #4A90D9;
  font-size: 64rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.brand-title {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
}

.brand-sub {
  color: rgba(255, 255, 255, 0.75);
  font-size: 26rpx;
  margin-top: 12rpx;
}

/* 登录按钮区 */
.login-ways {
  padding: 60rpx 60rpx 0;
}

.way {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  margin-bottom: 30rpx;
  font-size: 32rpx;
  color: #ffffff;
}

.way::after {
  border: none;
}

.way-icon {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  font-size: 26rpx;
  margin-right: 16rpx;
}

.wechat {
  background: #07c160;
}

.phone {
  background: #4A90D9;
}

.guest {
  background: #9aa5b1;
}

/* 协议勾选 */
.agree-row {
  margin-top: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666666;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #cccccc;
  border-radius: 8rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  box-sizing: border-box;
}

.checkbox.checked {
  background: #4A90D9;
  border-color: #4A90D9;
}

.check-mark {
  color: #ffffff;
  font-size: 22rpx;
}

.agree-text {
  font-size: 24rpx;
  color: #666666;
}

.link {
  color: #4A90D9;
  margin: 0 4rpx;
}

/* 头像昵称授权弹窗 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-pop {
  width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.pop-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.pop-sub {
  font-size: 24rpx;
  color: #999999;
  margin-top: 12rpx;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 0;
  margin: 40rpx 0 16rpx;
  background: #f0f2f5;
  overflow: hidden;
  line-height: 160rpx;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  line-height: 160rpx;
  text-align: center;
  font-size: 60rpx;
  color: #cccccc;
}

.avatar-tip {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 30rpx;
}

.nick-input {
  width: 100%;
  height: 80rpx;
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.pop-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
  width: 100%;
}

.pop-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  border-radius: 42rpx;
}

.pop-btn::after {
  border: none;
}

.cancel {
  background: #f0f2f5;
  color: #666666;
}

.confirm {
  background: #4A90D9;
  color: #ffffff;
}

/* 手机号验证码登录弹窗 */
.sms-row {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 40rpx;
}

.sms-input {
  flex: 1;
  height: 80rpx;
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  width: 100%;
}

.sms-code-input {
  margin-top: 20rpx;
}

.code-btn {
  width: 220rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  color: #4A90D9;
  background: #eaf1f8;
  border-radius: 12rpx;
  padding: 0;
}

.code-btn::after {
  border: none;
}

.code-disabled {
  color: #999999;
  background: #f0f2f5;
}
