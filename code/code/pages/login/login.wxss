/* 登录页样式 */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1f4e79 0%, #2d6ba6 55%, #ffffff 55%);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  padding: 0 60rpx;
}

/* 顶部标题区 */
.hero {
  margin-top: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  font-size: 140rpx;
  line-height: 1;
  margin-bottom: 30rpx;
}

.title {
  font-size: 52rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.subtitle {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #dbe7f3;
}

/* 登录按钮区 */
.login-area {
  margin-top: 220rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-btn {
  width: 480rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  font-size: 34rpx;
  font-weight: bold;
  color: #1f4e79;
  background: #ffffff;
  border-radius: 48rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 78, 121, 0.25);
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  color: #1f4e79;
  opacity: 0.7;
}

.hint {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #7d8ea4;
}
