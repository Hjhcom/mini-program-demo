/* 设置页样式 */
.page {
  min-height: 100vh;
  background: #f5f6f7;
}

.group-title {
  font-size: 26rpx;
  color: #999999;
  padding: 30rpx 40rpx 14rpx;
}

.cell-group {
  background: #ffffff;
}

.cell {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 40rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.cell:last-child {
  border-bottom: none;
}

.cell-label {
  font-size: 30rpx;
  color: #333333;
}

.cell-right {
  display: flex;
  align-items: center;
}

.cache-size {
  font-size: 26rpx;
  color: #999999;
  margin-right: 8rpx;
}

.cell-arrow {
  font-size: 36rpx;
  color: #cccccc;
}

/* 字体大小选项 */
.font-options {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 40rpx 30rpx;
}

.font-option {
  flex: 1;
  text-align: center;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  background: #f5f6f7;
  color: #333333;
  font-size: 28rpx;
}

.font-option.active {
  background: #4A90D9;
  color: #ffffff;
}

/* 显示语言选项 */
.lang-options {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 40rpx 30rpx;
}

.lang-option {
  flex: 1;
  text-align: center;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  background: #f5f6f7;
  color: #333333;
  font-size: 28rpx;
}

.lang-option.active {
  background: #4A90D9;
  color: #ffffff;
}

/* 深色模式（设置页特有补充，全局覆盖在 app.wxss） */
.page.dark {
  background: #1c1c1e;
}

.page.dark .cell-group {
  background: #2c2c2e;
}

.page.dark .font-option.active {
  background: #4A90D9;
  color: #ffffff;
}
