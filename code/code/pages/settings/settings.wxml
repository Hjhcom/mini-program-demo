<!-- pages/settings/settings.wxml —— 设置页 -->
<view class="page {{dark ? 'dark' : ''}} {{fontScale == 'lg' ? 'font-lg' : fontScale == 'xl' ? 'font-xl' : ''}}">

  <!-- 通用 -->
  <view class="group-title">通用</view>
  <view class="cell-group">
    <view class="cell">
      <text class="cell-label">深色模式</text>
      <switch checked="{{dark}}" bindchange="onDarkChange" color="#1f4e79" />
    </view>
  </view>

  <!-- 字体大小 -->
  <view class="group-title">字体大小</view>
  <view class="cell-group">
    <view class="cell">
      <text class="cell-label">字体大小</text>
    </view>
    <view class="font-options">
      <view class="font-option {{fontScale == 'md' ? 'active' : ''}}" bindtap="onFontSelect" data-font="md">标准</view>
      <view class="font-option {{fontScale == 'lg' ? 'active' : ''}}" bindtap="onFontSelect" data-font="lg">大</view>
      <view class="font-option {{fontScale == 'xl' ? 'active' : ''}}" bindtap="onFontSelect" data-font="xl">特大</view>
    </view>
  </view>

  <!-- 存储 -->
  <view class="group-title">存储</view>
  <view class="cell-group">
    <view class="cell" bindtap="onClearCache">
      <text class="cell-label">清除缓存</text>
      <view class="cell-right">
        <text class="cache-size">{{cacheSize}}</text>
        <text class="cell-arrow">›</text>
      </view>
    </view>
  </view>

</view>
