<!-- pages/settings/settings.wxml —— 设置页 -->
<view class="page {{dark ? 'dark' : ''}} {{fontScale == 'lg' ? 'font-lg' : fontScale == 'xl' ? 'font-xl' : ''}}">

  <!-- 通用 -->
  <view class="group-title">{{lang.settings.general}}</view>
  <view class="cell-group">
    <view class="cell">
      <text class="cell-label">{{lang.settings.darkMode}}</text>
      <switch checked="{{dark}}" bindchange="onDarkChange" color="#4A90D9" />
    </view>
    <view class="cell">
      <text class="cell-label">{{lang.settings.language}}</text>
    </view>
    <view class="lang-options">
      <view class="lang-option {{language == 'zh' ? 'active' : ''}}" bindtap="onLanguageSelect" data-lang="zh">{{lang.settings.zh}}</view>
      <view class="lang-option {{language == 'en' ? 'active' : ''}}" bindtap="onLanguageSelect" data-lang="en">{{lang.settings.en}}</view>
    </view>
  </view>

  <!-- 字体大小 -->
  <view class="group-title">{{lang.settings.fontSize}}</view>
  <view class="cell-group">
    <view class="cell">
      <text class="cell-label">{{lang.settings.fontSize}}</text>
    </view>
    <view class="font-options">
      <view class="font-option {{fontScale == 'md' ? 'active' : ''}}" bindtap="onFontSelect" data-font="md">{{lang.settings.fontMd}}</view>
      <view class="font-option {{fontScale == 'lg' ? 'active' : ''}}" bindtap="onFontSelect" data-font="lg">{{lang.settings.fontLg}}</view>
      <view class="font-option {{fontScale == 'xl' ? 'active' : ''}}" bindtap="onFontSelect" data-font="xl">{{lang.settings.fontXl}}</view>
    </view>
  </view>

  <!-- 存储 -->
  <view class="group-title">{{lang.settings.storage}}</view>
  <view class="cell-group">
    <view class="cell" bindtap="onClearCache">
      <text class="cell-label">{{lang.settings.clearCache}}</text>
      <view class="cell-right">
        <text class="cache-size">{{cacheSize}}</text>
        <text class="cell-arrow">›</text>
      </view>
    </view>
  </view>

</view>
