/* pages/nearby/nearby.wxss —— 动态 */
.page {
  min-height: 100vh;
  position: relative;
  background: #f0e6d6;
}

.page-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  width: 100%;
  height: 100vh;
  z-index: 0;
}
.page-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg,
    rgba(255,255,255,0.55) 0%,
    rgba(255,255,255,0.75) 30%,
    rgba(255,255,255,0.88) 100%);
  z-index: 1;
}

.content {
  position: relative;
  z-index: 2;
  padding: 20rpx;
  box-sizing: border-box;
  padding-bottom: 120rpx;
}

/* 顶部 tab 切换 */
.feed-tabs {
  display: flex;
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(10rpx);
  border-radius: 40rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(180,120,60,0.08);
}
.feed-tab {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  color: #8a6f4a;
  border-radius: 36rpx;
  transition: all 0.2s;
}
.feed-tab.active {
  background: #4A90D9;
  color: #ffffff;
  font-weight: 500;
}

/* 发动态入口条 */
.publish-entry {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(180,120,60,0.08);
}
.publish-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}
.publish-text {
  font-size: 28rpx;
  color: #a08a6a;
}

/* 加载中 */
.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #8a6f4a;
  font-size: 28rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #5a4a3a;
  margin-bottom: 10rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #8a6f4a;
}

/* 动态列表 */
.feed {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feed-item {
  display: flex;
  padding: 28rpx;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(180,120,60,0.1);
}

/* 头像 */
.avatar {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #eef3f8;
  overflow: hidden;
  border: 3rpx solid #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #4A90D9;
}

/* 内容 */
.feed-content {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.feed-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.feed-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #2a2a2a;
}

.feed-time {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #b0a08a;
}

.feed-del {
  margin-left: auto;
  font-size: 22rpx;
  color: #e64340;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: #fff0f0;
}

.feed-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

/* 打卡点位标签气泡 */
.feed-point-tag {
  display: inline-flex;
  align-items: center;
  background: #eaf3fb;
  border-radius: 24rpx;
  padding: 8rpx 18rpx;
  margin-bottom: 10rpx;
}
.feed-point-pin {
  font-size: 22rpx;
  margin-right: 6rpx;
}
.feed-point-name {
  font-size: 24rpx;
  color: #2c6aa8;
  font-weight: 500;
}

.feed-spell {
  margin-top: 6rpx;
  margin-bottom: 6rpx;
  font-size: 24rpx;
  color: #8a7a6a;
  font-style: italic;
}

/* 打卡照片 */
.feed-photo {
  margin-top: 16rpx;
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  background: #f0e6d6;
}

/* 操作按钮：纯图标 + 数字 */
.feed-actions {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 36rpx;
}

.like-btn, .comment-btn {
  display: flex;
  align-items: center;
}

.like-icon, .comment-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.like-count, .comment-count {
  font-size: 24rpx;
  color: #9a8a7a;
}

.like-btn.liked .like-count {
  color: #e05a3a;
}

/* 评论弹层 */
.comment-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.comment-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.comment-panel.show {
  transform: translateY(0);
}

.comment-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.comment-panel-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.comment-panel-close {
  font-size: 32rpx;
  color: #999;
  padding: 0 10rpx;
}

.comment-list {
  flex: 1;
  padding: 20rpx 28rpx;
  max-height: 50vh;
}

.comment-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}

.comment-item {
  display: flex;
  margin-bottom: 24rpx;
}

.comment-avatar {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #eef3f8;
  overflow: hidden;
}

.comment-avatar-img {
  width: 100%;
  height: 100%;
}

.comment-avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #4A90D9;
}

.comment-body {
  flex: 1;
  margin-left: 16rpx;
}

.comment-name {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.comment-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
}

.comment-input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  gap: 16rpx;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background: #f5f7fa;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.comment-send-btn {
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #4A90D9;
  color: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
}
