/* pages/nearby/nearby.wxss —— 动态 */
.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 20rpx;
  box-sizing: border-box;
  padding-bottom: 120rpx;
}

/* 加载中 */
.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #999;
}

/* 动态列表 */
.feed {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feed-item {
  display: flex;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 头像 */
.avatar {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #eef3f8;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #4A90D9;
}

/* 内容 */
.feed-content {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.feed-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.feed-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.feed-time {
  font-size: 22rpx;
  color: #999;
}

.feed-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.feed-point {
  color: #4A90D9;
  font-weight: 500;
}

.feed-spell {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
  background: #f5f7fa;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
}

/* 打卡照片 */
.feed-photo {
  margin-top: 16rpx;
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
}

/* 操作按钮 */
.feed-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
}

.like-btn, .comment-btn {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #f5f7fa;
}

.like-btn.liked {
  background: #fff0f0;
}

.like-icon, .comment-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.like-count, .comment-count {
  font-size: 24rpx;
  color: #666;
}

.like-btn.liked .like-count {
  color: #e05a3a;
}

/* 评论弹层 */
.comment-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.comment-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.comment-panel.show {
  transform: translateY(0);
}

.comment-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.comment-panel-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.comment-panel-close {
  font-size: 32rpx;
  color: #999;
  padding: 0 10rpx;
}

.comment-list {
  flex: 1;
  padding: 20rpx 28rpx;
  max-height: 50vh;
}

.comment-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}

.comment-item {
  display: flex;
  margin-bottom: 24rpx;
}

.comment-avatar {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #eef3f8;
  overflow: hidden;
}

.comment-avatar-img {
  width: 100%;
  height: 100%;
}

.comment-avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #4A90D9;
}

.comment-body {
  flex: 1;
  margin-left: 16rpx;
}

.comment-name {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.comment-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
}

.comment-input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  gap: 16rpx;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background: #f5f7fa;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.comment-send-btn {
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #4A90D9;
  color: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
}
