<!--pages/nearby/nearby.wxml —— 动态-->
<view class="page {{dark ? 'dark' : ''}} {{fontScale == 'lg' ? 'font-lg' : fontScale == 'xl' ? 'font-xl' : ''}}">
  <image class="page-bg" src="/images/feed-bg.jpg" mode="aspectFill" />
  <view class="page-mask"></view>

  <view class="content">
  <!-- 顶部 tab：附近 / 关注 -->
  <view class="feed-tabs">
    <view class="feed-tab {{feedType == 'nearby' ? 'active' : ''}}" bindtap="switchTab" data-type="nearby">{{lang.nearby.tabNearby}}</view>
    <view class="feed-tab {{feedType == 'friends' ? 'active' : ''}}" bindtap="switchTab" data-type="friends">{{lang.nearby.tabFriends}}</view>
  </view>

  <!-- 发动态入口 -->
  <view class="publish-entry" bindtap="goPublish">
    <text class="publish-icon">✏️</text>
    <text class="publish-text">{{lang.nearby.publishEntry}}</text>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>{{lang.nearby.loading}}</text>
  </view>

  <!-- 空状态（插画式：emoji 放入圆形渐变底） -->
  <view class="empty" wx:elif="{{isEmpty}}">
    <view class="empty-illus">
      <text class="empty-illus-icon">📍</text>
    </view>
    <text class="empty-text">{{feedType == 'friends' ? lang.nearby.emptyFriends : lang.nearby.emptyNearby}}</text>
    <text class="empty-sub">{{feedType == 'friends' ? lang.nearby.emptyFriendsSub : lang.nearby.emptyNearbySub}}</text>
  </view>

  <!-- 动态列表：F-18 UI 单列精致信息流（朋友圈风） -->
  <view class="feed" wx:else>
    <template is="feedItem" wx:for="{{list}}" wx:key="_id" data="{{item}}" />

    <!-- 分页状态 -->
    <view class="feed-more" wx:if="{{loadingMore}}">{{lang.nearby.loadingMore}}</view>
    <view class="feed-more" wx:elif="{{!hasMore && list.length > 0}}">{{lang.nearby.noMore}}</view>
  </view>

  <!-- F-18 UI：单列信息流卡片（头像左 + 内容右） -->
  <template name="feedItem">
    <view class="feed-item {{item.highlight ? 'highlight' : ''}}">
      <!-- 头像（点击进入他人主页） -->
      <view class="avatar" wx:if="{{item.avatarUrl}}" data-id="{{item._id}}" bindtap="onAvatarTap">
        <image class="avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" />
      </view>
      <view class="avatar avatar-ph" wx:else data-id="{{item._id}}" bindtap="onAvatarTap">{{item.avatarText}}</view>

      <!-- 内容 -->
      <view class="feed-content">
        <view class="feed-head">
          <text class="feed-name" data-id="{{item._id}}" bindtap="onAvatarTap">{{item.nickname}}</text>
          <text class="feed-time">{{item.timeText}}</text>
          <!-- 自己的动态：删除按钮 -->
          <text wx:if="{{item.isMine}}" class="feed-del" data-id="{{item._id}}" bindtap="onDeleteTap">{{lang.nearby.delete}}</text>
        </view>

        <!-- 文字心情：直接展示内容 -->
        <view class="feed-text" wx:if="{{item.type == 'text'}}">{{item.content}}</view>

        <!-- 打卡记录：展示打卡点 + 咒语 -->
        <block wx:else>
          <view class="feed-point-tag {{item.pointId ? 'tag-go' : ''}}" wx:if="{{item.pointName}}"
                data-point="{{item.pointId}}" bindtap="onPointGoTap">
            <text class="feed-point-pin">📍</text>
            <text class="feed-point-name">{{item.pointName}}</text>
            <text class="feed-point-go" wx:if="{{item.pointId}}">› {{lang.nearby.goHere}}</text>
          </view>
          <view class="feed-spell" wx:if="{{item.spell}}">
            「{{item.spell}}」
          </view>
        </block>

        <!-- 打卡照片：4:3 圆角 -->
        <image class="feed-photo" wx:if="{{item.photoFileID}}" src="{{item.photoFileID}}" mode="aspectFill" data-src="{{item.photoFileID}}" bindtap="onPhotoPreview" />

        <!-- 操作按钮 -->
        <view class="feed-actions">
          <view class="like-btn {{item.isLiked ? 'liked' : ''}}" data-id="{{item._id}}" bindtap="onLikeTap">
            <text class="like-icon">{{item.isLiked ? '❤️' : '🤍'}}</text>
            <text class="like-count">{{item.likesCount || 0}}</text>
          </view>
          <view class="comment-btn" data-id="{{item._id}}" bindtap="onCommentTap">
            <text class="comment-icon">💬</text>
            <text class="comment-count">{{item.commentCount || 0}}</text>
          </view>
        </view>
      </view>
    </view>
  </template>
  </view>

  <!-- 评论弹层 -->
  <view class="comment-mask" wx:if="{{showCommentPanel}}" bindtap="closeCommentPanel"></view>
  <view class="comment-panel {{showCommentPanel ? 'show' : ''}}">
    <view class="comment-panel-head">
      <text class="comment-panel-title">{{lang.nearby.commentTitle}}</text>
      <text class="comment-panel-close" bindtap="closeCommentPanel">✕</text>
    </view>
    <scroll-view class="comment-list" scroll-y bindscrolltolower="loadMoreComments">
      <view class="comment-empty" wx:if="{{commentList.length === 0}}">
        {{lang.nearby.commentEmpty}}
      </view>
      <view class="comment-item" wx:for="{{commentList}}" wx:key="_id">
        <view class="comment-avatar" wx:if="{{item.avatarUrl}}">
          <image class="comment-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" />
        </view>
        <view class="comment-avatar comment-avatar-ph" wx:else>{{item.avatarText}}</view>
        <view class="comment-body">
          <view class="comment-head">
            <text class="comment-name">{{item.nickname}}</text>
            <text class="comment-time">{{item.timeText}}</text>
            <text wx:if="{{item.isMine}}" class="comment-del" data-id="{{item._id}}" bindtap="onDeleteComment">{{lang.nearby.commentDelete}}</text>
          </view>
          <text class="comment-text">{{item.content}}</text>
          <view class="comment-like" data-id="{{item._id}}" bindtap="onLikeComment">
            <text class="comment-like-icon">{{item.isLiked ? '❤️' : '🤍'}}</text>
            <text class="comment-like-count">{{item.likesCount || 0}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="comment-input-bar">
      <input class="comment-input" placeholder="{{lang.nearby.commentPlaceholder}}" value="{{commentText}}" bindinput="onCommentInput" confirm-type="send" bindconfirm="onSendComment" />
      <view class="comment-send-btn" bindtap="onSendComment">{{lang.nearby.send}}</view>
    </view>
  </view>
</view>
