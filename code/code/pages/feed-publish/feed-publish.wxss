/* pages/feed-publish/feed-publish.wxss */
.page {
  min-height: 100vh;
  background: #ffffff;
  padding: 30rpx;
  box-sizing: border-box;
}

.content-input {
  width: 100%;
  min-height: 240rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: #333;
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  color: #bbb;
  margin-top: 10rpx;
}

.photo-section {
  margin-top: 40rpx;
}

.photo-preview {
  position: relative;
  width: 240rpx;
  height: 240rpx;
}
.photo-img {
  width: 240rpx;
  height: 240rpx;
  border-radius: 12rpx;
}
.photo-remove {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-add {
  width: 240rpx;
  height: 240rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}
.photo-add-icon {
  font-size: 60rpx;
  line-height: 1;
  margin-bottom: 10rpx;
}
.photo-add-text {
  font-size: 24rpx;
}

.publish-btn {
  margin: 80rpx 20rpx 0;
  height: 88rpx;
  line-height: 88rpx;
  background: #4A90D9;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}
.publish-btn::after { border: none; }
.publish-btn[disabled] { opacity: 0.7; }
