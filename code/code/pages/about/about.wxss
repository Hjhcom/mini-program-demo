/* 「关于」页样式（F-12）—— 主色沿用 #4A90D9，卡片式排版 */
.page {
  min-height: 100vh;
  background: #f5f6f7;
  padding-bottom: 40rpx;
}

/* ===== 头部 ===== */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 40rpx 40rpx;
  background: linear-gradient(180deg, #4A90D9 0%, #2c6ba0 100%);
}

.logo {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  text-align: center;
  font-size: 60rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.16);
  margin-bottom: 20rpx;
}

.app-name {
  font-size: 38rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.version {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
}

.tagline {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.86);
  text-align: center;
  line-height: 1.6;
  padding: 0 20rpx;
}

/* ===== 分组标题与卡片 ===== */
.group-title {
  font-size: 26rpx;
  color: #999999;
  padding: 32rpx 40rpx 14rpx;
}

.card {
  background: #ffffff;
  padding: 28rpx 32rpx;
  margin: 0 24rpx;
  border-radius: 16rpx;
}

.para {
  display: block;
  font-size: 28rpx;
  line-height: 1.75;
  color: #333333;
}

.para.strong {
  font-weight: 600;
  color: #4A90D9;
  margin-bottom: 12rpx;
}

/* 带圆点的条目 */
.li {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
}

.dot {
  flex: none;
  width: 24rpx;
  font-size: 28rpx;
  line-height: 1.75;
  color: #4A90D9;
}

.li .para {
  flex: 1;
}

/* ===== 团队分工 ===== */
.team-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.team-row:last-child {
  border-bottom: none;
}

.team-who {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.team-job {
  font-size: 26rpx;
  color: #888888;
  text-align: right;
  margin-left: 20rpx;
}

.note {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
  padding: 14rpx 44rpx 0;
}

/* ===== AI 使用说明：单独强调，避免在报告里被当成"没标注" ===== */
.ai-card {
  border-left: 8rpx solid #4A90D9;
  background: #f2f7fc;
}

.ai-note {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #666666;
}

/* ===== 页脚 ===== */
.copyright {
  margin-top: 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b0b0;
  line-height: 1.6;
  padding: 0 60rpx;
}

/* ===== 深色模式 ===== */
.page.dark {
  background: #1c1c1e;
}

.page.dark .hero {
  background: linear-gradient(180deg, #17395a 0%, #4A90D9 100%);
}

.page.dark .group-title {
  color: #8e8e93;
}

.page.dark .card {
  background: #2c2c2e;
}

.page.dark .para {
  color: #e5e5e7;
}

.page.dark .para.strong {
  color: #7fb0dd;
}

.page.dark .dot {
  color: #7fb0dd;
}

.page.dark .team-row {
  border-bottom-color: #3a3a3c;
}

.page.dark .team-who {
  color: #e5e5e7;
}

.page.dark .team-job {
  color: #98989d;
}

.page.dark .note {
  color: #8e8e93;
}

.page.dark .ai-card {
  background: #22303d;
  border-left-color: #7fb0dd;
}

.page.dark .ai-note {
  color: #b0b0b5;
}

.page.dark .copyright {
  color: #6e6e73;
}

/* ===== 字号设置（与其它页一致：lg 上调一档，xl 再上一档） ===== */
.page.font-lg .para {
  font-size: 32rpx;
}

.page.font-lg .group-title {
  font-size: 28rpx;
}

.page.font-lg .team-who,
.page.font-lg .team-job {
  font-size: 30rpx;
}

.page.font-xl .para {
  font-size: 36rpx;
}

.page.font-xl .group-title {
  font-size: 30rpx;
}

.page.font-xl .team-who,
.page.font-xl .team-job {
  font-size: 34rpx;
}
